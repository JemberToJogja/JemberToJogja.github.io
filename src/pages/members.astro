    pointer-events: none;

    border-radius: 50%;

    background: rgba(
      255,
      255,
      255,
      0.08
    );

    filter: blur(3px);

    transform:
      translate3d(
        -50px,
        -50px,
        0
      );

    opacity: 0;

    mix-blend-mode: difference;
  }

  @media (min-width: 900px) {
    .cursor-glow {
      opacity: 1;
    }
  }

  /* =============================================================
     HEADER
  ============================================================= */

  .site-header {
    position: sticky;

    top: 0;

    z-index: 80;

    background:
      rgba(
        16,
        16,
        16,
        0.95
      );

    color: #f2f0ea;

    border-bottom: 1px solid #2c2c2c;

    backdrop-filter:
      blur(12px);
  }

  .header-inner {
    width: min(
      calc(100% - 20px),
      1180px
    );

    min-height: 62px;

    margin-inline: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;
  }

  .brand {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    min-width: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    display: grid;

    place-items: center;

    background: #f2f0ea;

    color: #101010;

    font-size: 10px;

    font-weight: 950;
  }

  .brand-name {
    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 0.11em;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-github {
    width: 38px;
    height: 38px;

    display: grid;

    place-items: center;

    border: 1px solid #454545;

    color: #f2f0ea;

    font-size: 17px;
  }

  /* =============================================================
     BUTTONS
  ============================================================= */

  .button {
    min-height: 48px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    padding:
      0
      16px;

    border: 1px solid transparent;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );

    transition:
      transform
        160ms
        cubic-bezier(
          .2,
          .8,
          .2,
          1
        ),
      background-color 140ms ease,
      border-color 140ms ease;
  }

  .button-primary {
    background: #111111;

    color: #f2f0ea;
  }

  .button-primary:hover {
    background: #292929;
  }

  .button-light {
    background: #f2f0ea;

    color: #111111;
  }

  .button-light:hover {
    background: #ffffff;
  }

  /* =============================================================
     HERO
  ============================================================= */

  .page-hero {
    position: relative;

    overflow: hidden;

    padding:
      32px
      0
      45px;

    background: #f2f0ea;

