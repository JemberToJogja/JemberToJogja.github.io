    color: #7b776f;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.09em;

    opacity: 0;

    animation:
      fade-up
      700ms
      520ms
      cubic-bezier(
        .16,
        1,
        .3,
        1
      )
      forwards;
