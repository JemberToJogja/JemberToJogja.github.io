      0;

    color: #5f5b54;

    font-size: 13px;

    line-height: 1.7;

    opacity: 0;

    transform:
      translateY(15px);

    animation:
      fade-up
      700ms
      280ms
      cubic-bezier(
        .16,
        1,
        .3,
        1
      )
      forwards;
  }

  .hero-status {
    width: 145px;

    justify-self: end;

    display: grid;

    gap: 5px;

    padding: 14px;

    background: #dedbd3;

    border:
