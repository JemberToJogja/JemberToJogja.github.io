  .hero-bottom span + span::before {
    content: "/";

    margin-right: 14px;

    color: #aaa69d;
  }

  /* =============================================================
     STATS
  ============================================================= */

  .stats-section {
    background: #111111;

    color: #f5f3ec;
  }

  .stats-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        1fr
      );
  }

  .stat {
    min-height: 118px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    gap: 5px;

    padding:
      13px
      10px;

    border-right:
