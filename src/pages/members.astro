  {
    number: "01",
    name: "Afriza Wahyu Ardiansyah",
    initials: "AA",
    role: "FULL-STACK WEB DEVELOPER",
    location: "JEMBER / EAST JAVA",
    education:
      "POLITEKNIK NEGERI JEMBER / TEKNIK INFORMATIKA",
    category: "FULL-STACK / WEB",
    description:
      "Full-stack developer working across web systems and application development with Laravel and Flutter.",
    story:
      "Afriza works across the full web development stack and application layer, with experience moving between backend systems, web interfaces, and mobile development.",
    focus: [
      "Full-Stack",
      "Web Development",
      "Laravel",
      "Flutter",
    ],
    project: "Griya Batik",
    projectDescription:
      "Web and Android/Flutter e-commerce project for a batik business.",
    linkedin:
      "https://id.linkedin.com/in/afriza-wahyu-ardiansyah",
    accent: "dark",
  },
  {
    number: "02",
    name: "Muhammad Daniel Umar",
    initials: "MD",
    role: "ANDROID & WEBSITE DEVELOPER",
    location: "PROBOLINGGO / EAST JAVA",
    education: "POLITEKNIK NEGERI JEMBER",
    category: "ANDROID / WEB",
    description:
      "Developer working across Android and web development, with an interest in practical mobile and software projects.",
    story:
      "Daniel works across application development and web technology, bringing a mobile-oriented perspective into the projects built by the team.",
    focus: ["Android", "Web Development", "Mobile", "Software"],
    project: "KabarU",
    projectDescription:
      "Campus information platform developed across web and mobile contexts.",
    linkedin:
      "https://id.linkedin.com/in/muhammaddanielumar",
    accent: "light",
  },
  {
    number: "03",
    name: "Moh. Habiburrohman",
    initials: "MH",
    role: "FRONTEND & ANDROID APP SPECIALIST",
    location: "JEMBER / EAST JAVA",
    education:
      "POLITEKNIK NEGERI JEMBER / D4 TEKNIK INFORMATIKA",
    category: "ANDROID / AI / IOT",
    description:
      "Developer interested in frontend systems, Android applications, AI, and IoT.",
    story:
      "Habib works at the intersection of application development and emerging technology, with interests spanning mobile, web, artificial intelligence, and connected devices.",
    focus: ["Android", "Web", "AI", "IoT"],
    project: "Maw-Buket",
    projectDescription:
      "Web-based e-commerce system covering products, transactions, and online ordering.",
    linkedin:
      "https://id.linkedin.com/in/moh-habiburrohman",
    accent: "paper",
  },
  {
    number: "04",
    name: "Kholifatin Khoiriyah",
    initials: "KK",
    role: "QA / SOFTWARE TESTING / FRONT-END",
    location: "JEMBER / EAST JAVA",
    education:
      "POLITEKNIK NEGERI JEMBER / 2023–2027",
    category: "QA / TESTING",
    description:
      "Quality assurance enthusiast working across software testing, frontend development, documentation, and project coordination.",
    story:
      "Kholifatin brings the testing side of software into the team, combining quality assurance with frontend development and project-oriented work.",
    focus: [
      "Quality Assurance",
      "Software Testing",
      "Front-End",
      "Project Management",
    ],
    project: "PLAWANGAN CAFE",
    projectDescription:
      "Website and POS project involving frontend work, functional testing, and bug documentation.",
    linkedin:
      "https://id.linkedin.com/in/kholifatinkhoiriyah",
    accent: "light",
  },
];

const stats = [
  {
    value: "04",
    label: "TEAM MEMBERS",
  },
  {
    value: "04",
    label: "SPECIALTIES",
  },
  {
    value: "01",
    label: "CURRENT INTERNSHIP",
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content="People behind JemberToJogja — developers, software testers, mobile engineers, and builders."
    />

    <meta
      name="theme-color"
      content="#101010"
    />

    <meta
      property="og:title"
      content="People — JemberToJogja"
    />

    <meta
      property="og:description"
      content="Meet the people behind JemberToJogja."
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://jembertojogja.github.io/members"
    />

    <link
      rel="canonical"
      href="https://jembertojogja.github.io/members"
    />

    <title>
      People — JemberToJogja
    </title>
  </head>

  <body>
    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="site-header">
      <div class="header-inner">
        <a
          href="/"
          class="brand"
          aria-label="JemberToJogja home"
        >
          <span class="brand-mark">
            JTJ
          </span>

          <span class="brand-name">
            JEMBERTOJOGJA
          </span>
        </a>

        <nav
          class="desktop-nav"
          aria-label="Primary navigation"
        >
          <a href="/projects">
            Projects
          </a>

          <a
            href="/members"
            class="active"
          >
            People
          </a>

          <a href="/play">
            Play
          </a>

          <a
            href="https://github.com/JemberToJogja"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </nav>

        <a
          class="mobile-github"
          href="https://github.com/JemberToJogja"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open JemberToJogja on GitHub"
        >
          ↗
        </a>
      </div>
    </header>

    <main>
      <!-- =========================================================
           PAGE HERO
      ========================================================== -->

      <section class="page-hero">
        <div class="container">
          <div class="hero-meta">
            <a
              href="/"
              class="back-link"
            >
              ← Back home
            </a>

            <span class="mono">
              PEOPLE / 02
            </span>
          </div>

          <div class="hero-main">
            <div>
              <p class="eyebrow">
                THE HUMANS
              </p>

              <h1>
                People
                <span>
                  behind the work.
                </span>
              </h1>
            </div>

            <div class="hero-description">
              <p>
                Developers, testers, students,
                and builders working across software,
                mobile, web, and technology in the field.
              </p>

              <strong>
                Four people. One team.
              </strong>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           STATS
      ========================================================== -->

      <section class="stats-section">
        <div class="container stats-grid">
          {
            stats.map((stat) => (
              <div class="stat">
                <strong>
                  {stat.value}
                </strong>

                <span>
                  {stat.label}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- =========================================================
           FEATURED PERSON
      ========================================================== -->

      <section class="featured-section">
        <div class="container">
          <div class="section-label">
            <span class="section-kicker">
              FEATURED PROFILE
            </span>

            <span class="mono">
              01 / 04
            </span>
          </div>

          <article class="featured-person">
            <div class="featured-top">
              <div>
                <span class="person-number">
                  {members[0].number}
                </span>

                <span class="person-category">
                  {members[0].category}
                </span>
              </div>

              <span class="status-pill">
                <span></span>
                JEMBERTOJOGJA
              </span>
            </div>

            <div class="featured-initials">
              {members[0].initials}
            </div>

            <div class="featured-body">
              <div>
                <p class="mono">
                  {members[0].role}
                </p>

                <h2>
                  {members[0].name}
                </h2>

                <p class="person-location">
                  {members[0].location}
                </p>
              </div>

              <div>
                <p class="large-copy">
                  {members[0].description}
                </p>

                <p class="small-copy">
                  {members[0].story}
                </p>
              </div>
            </div>

            <div class="featured-facts">
              <div>
                <span>
                  EDUCATION
                </span>

                <strong>
                  {members[0].education}
                </strong>
              </div>

              <div>
                <span>
                  SELECTED PROJECT
                </span>

                <strong>
                  {members[0].project}
                </strong>
              </div>
            </div>

            <div class="featured-bottom">
              <div class="technology-list">
                {
                  members[0].focus.map(
                    (item) => (
                      <span>
                        {item}
                      </span>
                    ),
                  )
                }
              </div>

              <a
                class="button button-light"
                href={members[0].linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                View LinkedIn
                <span>↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- =========================================================
           OTHER PEOPLE
      ========================================================== -->

      <section class="all-members-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-kicker">
                THE REST OF THE TEAM
              </p>

              <h2>
                More people.
              </h2>
            </div>

            <p>
              Different specialties.
              <br />
              Same project folder.
            </p>
          </div>

          <div class="members-list">
            {
              members.slice(1).map((member) => (
                <article
                  class:list={[
                    "member-card",
                    `member-${member.accent}`,
                  ]}
                >
                  <div class="member-top">
                    <div>
                      <span class="person-number">
                        {member.number}
                      </span>

                      <span class="person-category">
                        {member.category}
                      </span>
                    </div>

                    <span class="status-pill small">
                      <span></span>
                      ACTIVE
                    </span>
                  </div>

                  <div class="member-mark">
                    {member.initials}
                  </div>

                  <div class="member-content">
                    <p class="member-role mono">
                      {member.role}
                    </p>

                    <h3>
                      {member.name}
                    </h3>

                    <p class="person-location">
                      {member.location}
                    </p>

                    <p class="member-description">
                      {member.description}
                    </p>

                    <p class="member-story">
                      {member.story}
                    </p>

                    <div class="member-facts">
                      <div>
                        <span>
                          EDUCATION
                        </span>

                        <strong>
                          {member.education}
                        </strong>
                      </div>

                      <div>
                        <span>
                          SELECTED PROJECT
                        </span>

                        <strong>
                          {member.project}
                        </strong>
                      </div>
                    </div>

                    <div class="technology-list">
                      {
                        member.focus.map(
                          (item) => (
                            <span>
                              {item}
                            </span>
                          ),
                        )
                      }
                    </div>
                  </div>

                  <div class="member-footer">
                    <div>
                      <span class="footer-label">
                        PROJECT NOTE
                      </span>

                      <p>
                        {member.projectDescription}
                      </p>
                    </div>

                    <a
                      class="member-link"
                      href={member.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      View LinkedIn
                      <span>↗</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================================================
           INTERNSHIP
      ========================================================== -->

      <section class="internship-section">
        <div class="container">
          <div class="internship-card">
            <div class="internship-top">
              <span class="section-kicker light">
                CURRENT CHAPTER
              </span>

              <span class="mono">
                INTERNSHIP / 01
              </span>
            </div>

            <div class="internship-main">
              <div>
                <p class="internship-kicker">
                  ALL FOUR CURRENTLY
                </p>

                <h2>
                  Learning at
                  <span>
                    TechnoGIS Indonesia.
                  </span>
                </h2>
              </div>

              <div>
                <p class="internship-description">
                  Our current internship brings software
                  closer to real geospatial technology:
                  GIS, GNSS, surveying, mapping,
                  remote sensing, cameras, and
                  field-oriented systems.
                </p>

                <a
                  href="https://www.technogis.co.id/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="button button-light"
                >
                  Visit TechnoGIS
                  <span>↗</span>
                </a>
              </div>
            </div>

            <div class="internship-footer">
              <div>
                <span>
                  FIELD
                </span>

                <strong>
                  GEOSPATIAL TECHNOLOGY
                </strong>
              </div>

              <div>
                <span>
                  FOCUS
                </span>

                <strong>
                  GIS · GNSS · REMOTE SENSING
                </strong>
              </div>

              <div>
                <span>
                  LOCATION
                </span>

                <strong>
                  YOGYAKARTA
                </strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           TEAM PHILOSOPHY
      ========================================================== -->

      <section class="philosophy-section">
        <div class="container philosophy-grid">
          <div>
            <p class="section-kicker">
              HOW WE WORK
            </p>

            <h2>
              Different roles.
              Shared curiosity.
            </h2>
          </div>

          <div class="philosophy-list">
            <article>
              <span class="mono">
                01
              </span>

              <div>
                <h3>
                  Build.
                </h3>

                <p>
                  Applications, web systems,
                  mobile software, and things
                  that started as experiments.
                </p>
              </div>
            </article>

            <article>
              <span class="mono">
                02
              </span>

              <div>
                <h3>
                  Test.
                </h3>

                <p>
                  Check the software, find the bugs,
                  document what went wrong, then fix it.
                </p>
              </div>
            </article>

            <article>
              <span class="mono">
                03
              </span>

              <div>
                <h3>
                  Learn.
                </h3>

                <p>
                  Still students. Still experimenting.
                  Still asking how hard it could possibly be.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- =========================================================
           NEXT
      ========================================================== -->

      <section class="next-section">
        <div class="container next-grid">
          <div>
            <p class="section-kicker">
              WHAT'S NEXT?
            </p>

            <h2>
              See what
              we built.
            </h2>

            <p>
              People are only part of the story.
              The projects are the other part.
            </p>
          </div>

          <a
            class="button button-primary"
            href="/projects"
          >
            Explore projects
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- =========================================================
           FOOTER
      ========================================================== -->

      <section class="final-section">
        <div class="container">
          <div class="final-line">
            <span class="mono">
              JEMBERTOJOGJA / {year}
            </span>

            <p>
              Built with Astro. Hosted on GitHub Pages.
              Currently learning by building.
            </p>

            <span class="mono">
              PEOPLE_DONE_
            </span>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================================================
         MOBILE NAV
    ========================================================== -->

    <nav
      class="mobile-nav"
      aria-label="Mobile navigation"
    >
      <a href="/">
        <span>⌂</span>
        Home
      </a>

      <a href="/projects">
        <span>＋</span>
        Projects
      </a>

      <a
        href="/members"
        class="active"
      >
        <span>●</span>
        People
      </a>

      <a href="/play">
        <span>▶</span>
        Play
      </a>
    </nav>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #111111;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f2f0ea;
    color: #111111;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(::selection) {
    background: #111111;
    color: #f2f0ea;
  }

  .container {
    width: min(100% - 32px, 1180px);
    margin-inline: auto;
  }

  .mono {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  /* =============================================================
     HEADER
  ============================================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;

    background: #101010;
    color: #f5f3ec;

    border-bottom: 1px solid #2b2b2b;
  }

  .header-inner {
    width: min(100% - 24px, 1180px);
    min-height: 64px;
    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;

    display: grid;
    place-items: center;

    background: #f5f3ec;
    color: #101010;

    font-size: 10px;
    font-weight: 900;
  }

  .brand-name {
    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;

    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-github {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border: 1px solid #454545;

    color: #f5f3ec;

    font-size: 17px;
  }

  /* =============================================================
     GENERAL
  ============================================================= */

  .eyebrow,
  .section-kicker {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .section-kicker {
    margin: 0 0 10px;
    color: #66645e;
  }

  .section-kicker.light {
    color: #99968e;
  }

  .button {
    min-height: 48px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    padding: 0 18px;

    border: 1px solid transparent;

    font-size: 10px;
    font-weight: 900;

    letter-spacing: 0.08em;
    text-transform: uppercase;

    transition:
      transform 120ms ease,
      background-color 120ms ease,
      color 120ms ease;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button-primary,
  .button-dark {
    background: #111111;
    color: #f5f3ec;
  }

  .button-primary:hover,
  .button-dark:hover {
    background: #292929;
  }

  .button-light {
    background: #f5f3ec;
    color: #111111;
  }

  .button-light:hover {
    background: #ffffff;
  }

  /* =============================================================
     PAGE HERO
  ============================================================= */

  .page-hero {
    padding: 34px 0 52px;

    background: #f2f0ea;
    border-bottom: 1px solid #cbc8c0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;

    margin-bottom: 56px;
  }

  .back-link {
    font-size: 11px;
    font-weight: 800;
  }

  .hero-meta .mono {
    color: #77736c;
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .hero-main {
    display: grid;
    gap: 28px;
  }

  .hero-main .eyebrow {
    margin-bottom: 20px;
  }

  .hero-main h1 {
    max-width: 850px;

    margin: 0;

    font-size: clamp(
      54px,
      15vw,
      120px
    );

    font-weight: 900;

    line-height: 0.88;

    letter-spacing: -0.07em;
  }

  .hero-main h1 span {
    display: block;
    color: #6c6962;
  }

  .hero-description {
    max-width: 580px;
  }

  .hero-description p {
    margin: 0 0 8px;

    color: #595650;

    font-size: 14px;
    line-height: 1.55;
  }

  .hero-description strong {
    font-size: 17px;
    line-height: 1.3;
  }

  /* =============================================================
     STATS
  ============================================================= */

  .stats-section {
    background: #111111;
    color: #f5f3ec;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stat {
    min-height: 122px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    gap: 7px;

    padding: 15px 12px;

    border-right: 1px solid #303030;
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat strong {
    font-size: clamp(
      30px,
      8vw,
      54px
    );

    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .stat span {
    color: #95928a;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 700;

    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  /* =============================================================
     FEATURED PERSON
  ============================================================= */

  .featured-section {
    padding: 58px 0;
    background: #f2f0ea;
  }

  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 16px;
  }

  .section-label .section-kicker {
    margin: 0;
  }

  .section-label .mono {
    color: #86827a;
    font-size: 9px;
  }

  .featured-person {
    padding: 20px;

    background: #111111;
    color: #f5f3ec;
  }

  .featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;
  }

  .featured-top > div {
    display: flex;
    align-items: center;

    gap: 10px;
  }

  .person-number,
  .person-category {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 0.1em;
  }

  .person-number {
