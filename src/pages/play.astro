  .hero-button.secondary {
    border-color: #3d3d3d;
    color: #ddd9d1;
  }

  .hero-button.secondary:hover {
    background: #1b1b1b;
  }

  .hero-secondary {
    max-width: 520px;
  }

  .hero-terminal {
    overflow: hidden;

    border:
      1px
      solid
      #30302e;

    background: #121212;
  }

  .terminal-bar {
    min-height: 40px;

    display: flex;

    align-items: center;

    gap: 5px;

    padding:
      0
      10px;

    background: #171717;

    border-bottom:
      1px
      solid
      #2a2a28;
  }

  .terminal-bar > span {
    width: 6px;
    height: 6px;

    background: #55544f;

    border-radius: 50%;
  }

  .terminal-bar strong {
    margin-left: 7px;

    color: #66645f;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 800;

    letter-spacing: 0.08em;
  }

  .terminal-body {
    display: grid;

    gap: 9px;

    min-height: 148px;

    padding: 15px;

    color: #97938b;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 8px;

    line-height: 1.55;
  }

  .terminal-muted {
    color: #4c4b47;
  }

  .terminal-cursor {
    width: fit-content;

    color: #eeeae1;

    animation:
      cursor-blink
      1.2s
      steps(2)
      infinite;
  }

  .hero-stats {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        1fr
      );

    margin-top: 10px;

    border-top:
      1px
      solid
      #2c2c2a;

    border-bottom:
      1px
      solid
      #2c2c2a;
  }

  .hero-stat {
    min-height: 73px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    gap: 4px;

    padding:
      10px;

    border-right:
      1px
      solid
      #2c2c2a;

    opacity: 0;

    transform:
      translateY(12px);

    animation:
      stat-in
      650ms
      cubic-bezier(
        .16,
        1,
        .3,
        1
      )
      forwards;

    animation-delay:
      var(--delay, 0ms);
  }

  .hero-stat:last-child {
    border-right: 0;
  }

  .hero-stat strong {
    color: #efebe2;

    font-size: 26px;

    line-height: 0.85;

    letter-spacing: -0.07em;
  }

  .hero-stat span {
    color: #5f5d57;

    font-size: 6px;

    font-weight: 800;

    letter-spacing: 0.08em;
  }

  .hero-footer {
    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    padding-bottom: 19px;

    color: #54524d;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .hero-footer span + span::before {
    content: "/";

    margin-right: 7px;

    color: #393835;
  }

  /* =============================================================
     ARCADE
  ============================================================= */

  .arcade-section {
    position: relative;

    overflow: hidden;

    padding:
      58px
      0
      70px;

    background: #101010;
  }

  .arcade-grid-bg {
    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: 0.4;

    background-image:
      linear-gradient(
        rgba(
          255,
          255,
          255,
          0.02
        )
        1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(
          255,
          255,
          255,
          0.02
        )
        1px,
        transparent 1px
      );

    background-size:
      25px
      25px;

    animation:
      grid-drift
      14s
      linear
      infinite;
  }

  .arcade-section .container {
    position: relative;

    z-index: 2;
  }

  .section-heading {
    display: flex;

    flex-direction: column;

    gap: 14px;

    margin-bottom: 26px;
  }

  .section-heading-main {
    display: flex;

    align-items: flex-start;

    gap: 13px;
  }

  .section-heading h2 {
    margin: 4px 0 0;

    color: #eeeae1;

    font-size:
      clamp(
        44px,
        12vw,
        92px
      );

    font-weight: 950;

    line-height: 0.86;

    letter-spacing: -0.075em;
  }

  .section-heading-note {
    margin: 0;

    color: #66645f;

    font-size: 10px;

    font-weight: 650;

    line-height: 1.6;
  }

  .game-grid {
    display: grid;

    gap: 12px;
  }

  .game-card {
    position: relative;

    display: flex;

    flex-direction: column;

    min-height: 500px;

    padding: 16px;

    background: #161616;

    border:
      1px
      solid
      #2d2d2d;

    opacity: 0;

    transform:
      translateY(30px);

    transition:
      opacity
        700ms
        cubic-bezier(
          .16,
          1,
          .3,
          1
        ),
      transform
        700ms
        cubic-bezier(
          .16,
          1,
          .3,
          1
        ),
      border-color
        160ms ease,
      background-color
        160ms ease;
  }

  .is-visible .game-card {
    opacity: 1;

    transform:
      translateY(0);

    transition-delay:
      var(--delay, 0ms);
  }

  .game-card:hover {
    border-color: #41413e;
    background: #191919;
  }

  .game-card-featured {
    min-height: 540px;

    background: #121212;

    border-color: #383838;
  }

  .game-card-featured:hover {
    background: #151515;
  }

  .game-card-top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;
  }

  .game-index,
  .game-category {
    color: #696761;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .game-card-featured .game-category {
    color: #b6b2aa;
  }

  .game-preview {
    position: relative;

    height: 175px;

    margin-top: 16px;

    overflow: hidden;

    background: #0b0b0b;

    border:
      1px
      solid
      #2a2a2a;
  }

  /* =============================================================
     KUNTILANAK PREVIEW
  ============================================================= */

  .preview-kuntilanak {
    position: absolute;

    inset: 0;

    overflow: hidden;

    background: #0a0d10;
  }

  .preview-kuntilanak::after {
    content: "";

    position: absolute;

    inset: 0;

    border:
      1px
      solid
      rgba(
        255,
        255,
        255,
        0.04
      );

    pointer-events: none;
  }

  .preview-stars i {
    position: absolute;

    width: 2px;
    height: 2px;

    background: #d5d0c5;

    border-radius: 50%;

    animation:
      star-flicker
      2.4s
      ease-in-out
      infinite;
  }

  .preview-stars i:nth-child(1) {
    top: 18%;
    left: 16%;
  }

  .preview-stars i:nth-child(2) {
    top: 26%;
    left: 29%;

    animation-delay:
      -0.5s;
  }

  .preview-stars i:nth-child(3) {
    top: 15%;
    left: 53%;

    animation-delay:
      -0.9s;
  }

  .preview-stars i:nth-child(4) {
    top: 31%;
    left: 67%;

    animation-delay:
      -1.1s;
  }

  .preview-stars i:nth-child(5) {
    top: 21%;
    left: 82%;

    animation-delay:
      -0.3s;
  }

  .preview-stars i:nth-child(6) {
    top: 42%;
    left: 74%;

    animation-delay:
      -1.5s;
  }

  .preview-moon {
    position: absolute;

    top: 23px;
    right: 25px;

    width: 58px;
    height: 58px;

    background: #e7dfc8;

    border-radius: 50%;

    box-shadow:
      0
      0
      0
      8px
      rgba(
        231,
        223,
        200,
        0.04
      );
  }

  .preview-wire {
    position: absolute;

    left: -10%;

    width: 120%;
    height: 1px;

    background: #484846;
  }

  .preview-wire-a {
    top: 66px;

    transform:
      rotate(
        3deg
      );
  }

  .preview-wire-b {
    top: 87px;

    transform:
      rotate(
        -4deg
      );
  }

  .preview-pole {
    position: absolute;

    right: 25%;

    bottom: 0;

    width: 6px;
    height: 126px;

    background: #575754;
  }

  .preview-pole::before {
    content: "";

    position: absolute;

    top: 27px;
    right: -29px;

    width: 60px;
    height: 5px;

    background: #565653;
  }

  .preview-tree {
    position: absolute;

    bottom: 0;

    width: 17px;
    height: 85px;

    background: #060606;
  }

  .preview-tree::before,
  .preview-tree::after {
    content: "";

    position: absolute;

    background: #060606;

    border-radius: 50%;
  }

  .preview-tree::before {
    width: 62px;
    height: 50px;

    left: -23px;
    bottom: 47px;
  }

  .preview-tree::after {
    width: 49px;
    height: 43px;

    left: -15px;
    bottom: 70px;
  }

  .preview-tree-left {
    left: 9%;
  }

  .preview-tree-right {
    right: 7%;

    height: 67px;
  }

  .preview-ghost {
    position: absolute;

    top: 53%;
    left: 48%;

    width: 42px;
    height: 66px;

    animation:
      preview-ghost-float
      2.4s
      ease-in-out
      infinite;
  }

  .preview-ghost-head {
    position: absolute;

    top: 0;
    left: 6px;

    width: 31px;
    height: 31px;

    background: #eee9dd;

    border-radius: 50%;
  }

  .preview-ghost-body {
    position: absolute;

    top: 22px;
    left: 2px;

    width: 38px;
    height: 39px;

    background: #eee9dd;

    clip-path:
      polygon(
        0 0,
        100% 0,
        87% 100%,
        66% 73%,
        49% 100%,
        30% 74%,
        8% 100%
      );
  }

  .preview-ghost-eye {
    position: absolute;

    top: 14px;

    width: 4px;
    height: 5px;

    background: #1d1d1d;

    border-radius: 50%;
  }

  .preview-ghost-eye.left {
    left: 16px;
  }

  .preview-ghost-eye.right {
    left: 27px;
  }

  .preview-hud {
    position: absolute;

    left: 11px;
    right: 11px;
    bottom: 10px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    padding-top: 8px;

    border-top:
      1px
      solid
      #30302e;

    color: #bab7ae;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 6px;

    font-weight: 800;

    letter-spacing: 0.1em;
  }

  /* =============================================================
     DEBUGGER PREVIEW
  ============================================================= */

  .preview-debugger {
    position: absolute;

    inset: 13px;
  }

  .debugger-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 5px;

    padding:
      6px
      7px;

    background: #202020;

    border:
      1px
      solid
      #353535;

    color: #7d7b75;

    font-size: 6px;

    font-weight: 800;
  }

  .debugger-grid {
    display: grid;

    grid-template-columns:
      repeat(
        6,
        1fr
      );

    gap: 2px;

    padding: 3px;

    background: #67655f;
  }

  .debugger-cell {
    aspect-ratio: 1;

    display: grid;

    place-items: center;

    background: #343432;

    color: #bbb8b0;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    box-shadow:
      inset 1px 1px 0 #4d4c48,
      inset -1px -1px 0 #262624;
  }

  .debugger-cell.open {
    background: #474642;

    box-shadow: none;
  }

  .debugger-cell.flag {
    color: #d07b70;
  }

  .debugger-cell.mine {
    background: #713e39;

    color: #f4ede3;

    box-shadow: none;
  }

  /* =============================================================
     TERMINAL PREVIEW
  ============================================================= */

  .preview-terminal {
    position: absolute;

    inset: 17px;

    padding: 11px;

    background: #0d0d0d;

    border:
      1px
      solid
      #303030;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  .terminal-top {
    display: flex;

    align-items: center;

    gap: 4px;

    margin-bottom: 14px;
  }

  .terminal-top span {
    width: 6px;
    height: 6px;

    background: #484743;

    border-radius: 50%;
  }

  .terminal-top strong {
    margin-left: auto;

    color: #595752;

    font-size: 6px;

    letter-spacing: 0.08em;
  }

  .terminal-line {
    display: grid;

    grid-template-columns:
      20px
      1fr;

    gap: 7px;

    margin-top: 9px;

    font-size: 7px;

    line-height: 1.5;
  }

  .terminal-line small {
    color: #4e4d49;
  }

  .terminal-line strong {
    color: #aaa8a1;

    font-weight: 700;
  }

  .terminal-line em {
    overflow: hidden;

    color: #efeadf;

    font-style: normal;

    text-overflow: ellipsis;

    white-space: nowrap;
  }

  .terminal-line.muted span {
    color: #5d5b56;
  }

  .terminal-line.active span {
    color: #eeeae1;

    animation:
      cursor-blink
      1.1s
      steps(2)
      infinite;
  }

  /* =============================================================
     2048 PREVIEW
  ============================================================= */

  .preview-2048 {
    position: absolute;

    inset: 27px;

    display: grid;

    grid-template-columns:
      repeat(
        2,
        1fr
      );

    gap: 6px;
  }

  .preview-2048 span {
    display: grid;

    place-items: center;

    background: #1d1d1b;

    border:
      1px
      solid
      #34332f;

    color: #ebe6db;

    font-size: 30px;

    font-weight: 950;

    letter-spacing: -0.06em;

    transition:
      transform
      300ms
      ease;
  }

  .game-card:hover .preview-2048 span:nth-child(1) {
    transform:
      translate(-2px, -2px);
  }

  .game-card:hover .preview-2048 span:nth-child(2) {
    transform:
      translate(2px, -2px);
  }

  .game-card:hover .preview-2048 span:nth-child(3) {
    transform:
      translate(-2px, 2px);
  }

  .game-card:hover .preview-2048 span:nth-child(4) {
    transform:
      translate(2px, 2px);
  }

  .preview-2048 span:nth-child(2) {
    background: #292824;
  }

  .preview-2048 span:nth-child(3) {
    background: #39362e;
  }

  .preview-2048 span:nth-child(4) {
    background: #514a3d;
  }

  /* =============================================================
     GAME CARD
  ============================================================= */

  .game-card-content {
    flex: 1;

    margin-top: 18px;
  }

  .game-subtitle {
    color: #6e6c66;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .game-card h3 {
    margin:
      7px
      0
      0;

    color: #efebe2;

    font-size:
      clamp(
        34px,
        9vw,
        62px
      );

    font-weight: 950;

    line-height: 0.84;

    letter-spacing: -0.075em;
  }

  .game-description {
    max-width: 620px;

    margin:
      17px
      0
      0;

    color: #85827b;

    font-size: 12px;

    line-height: 1.68;
  }

  .game-card-footer {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    margin-top: 24px;

    padding-top: 14px;

    border-top:
      1px
      solid
      #2a2a28;
  }

  .game-status {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #727069;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.09em;
  }

  .game-status i {
    width: 6px;
    height: 6px;

    background: #6e9b61;

    border-radius: 50%;

    box-shadow:
      0
      0
      0
      3px
      rgba(
        110,
        155,
        97,
        0.08
      );
  }

  .play-button,
  .wide-button {
    appearance: none;

    -webkit-appearance: none;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    min-height: 43px;

    padding:
      0
      14px;

    border:
      1px
      solid
      #eeeae1;

    background: #eeeae1;

    color: #101010;

    cursor: pointer;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 0.07em;

    touch-action: manipulation;

    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );

    transition:
      transform
        160ms
        cubic-bezier(
          .2,
          .8,
          .2,
          1
        ),
      background-color
        120ms ease,
      color
        120ms ease;
  }

  .play-button:hover,
  .wide-button:hover {
    background: #ffffff;
  }

  .play-button:active,
  .wide-button:active {
    transform:
      translateY(1px);
  }

  /* =============================================================
     STAGE
  ============================================================= */

  .stage-section {
    padding:
      18px
      0
      70px;

    background: #080808;
  }

  .game-stage {
    overflow: hidden;

    background: #101010;

    border:
      1px
      solid
      #2b2b2b;

    box-shadow:
      0
      20px
      45px
      rgba(
        0,
        0,
        0,
        0.18
      );
  }

  .stage-window-bar {
    min-height: 43px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
      0
      11px;

    background: #151515;

    border-bottom:
      1px
      solid
      #2a2a2a;
  }

  .window-brand {
    display: flex;

    align-items: center;

    gap: 5px;
  }

  .window-dot {
    width: 7px;
    height: 7px;

    background: #4a4a48;

    border-radius: 50%;
  }

  .window-brand strong {
    margin-left: 8px;

    color: #807e78;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .stage-status {
    color: #5f5d58;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.08em;
  }

  .stage-toolbar {
    min-height: 49px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 14px;

    padding:
      0
      12px;

    background: #0d0d0d;

    border-bottom:
      1px
      solid
      #292929;
  }

  .stage-toolbar-main {
    min-width: 0;

    display: flex;

    align-items: center;

    gap: 8px;
  }

  .stage-back {
    appearance: none;

    -webkit-appearance: none;

    padding: 0;

    border: 0;

    background: transparent;

    color: #e5e1d7;

    cursor: pointer;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 850;

    letter-spacing: 0.05em;
  }

  .stage-slash {
    color: #3e3e3c;
  }

  .stage-toolbar strong {
    overflow: hidden;

    color: #77756f;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.07em;

    text-overflow: ellipsis;

    white-space: nowrap;
  }

  .stage-path {
    color: #474641;

    font-size: 6px;

    font-weight: 800;

    letter-spacing: 0.08em;
  }

  .stage-content {
    min-height: 510px;

    display: grid;

    place-items: center;

    background: #0f0f0f;
  }

  .stage-empty {
    width: min(
      calc(100% - 42px),
      520px
    );

    text-align: center;

    color: #e9e5dc;

    animation:
      empty-breathe
      3s
      ease-in-out
      infinite;
  }

  .stage-empty-number {
    display: block;

    color: #30302e;

    font-size: 73px;

    font-weight: 950;

    line-height: 0.85;

    letter-spacing: -0.1em;
  }

  .stage-empty-kicker {
    margin:
      20px
      0
      0;

    color: #66635d;

