    <!-- =========================================================
         MOBILE NAV
    ========================================================== -->

    <nav
      class="mobile-nav"
      aria-label="Mobile navigation"
    >
      <a href="/">
        <span>⌂</span>
        Home
      </a>

      <a href="/projects">
        <span>＋</span>
        Projects
      </a>

      <a href="/members">
        <span>●</span>
        People
      </a>

      <a
        href="/play"
        class="active play-item"
      >
        <span>▶</span>
        Play
      </a>
    </nav>

    <script>
      type GameId =
        | "kuntilanak"
        | "debugger"
        | "commit-type"
        | "system-2048"
        | "receh-run"
        | "warung-defense"
        | "stack-trace"
        | "pixel-panic";

      type Destroyer =
        | (() => void)
        | null;

      type GameModule = {
        mountGame: (
          root: HTMLElement,
        ) =>
          | void
          | (() => void)
          | Promise<
              void | (() => void)
            >;
      };

      function getRequiredElement<
        T extends Element,
      >(selector: string): T {
        const element =
          document.querySelector<T>(
            selector,
          );

        if (!element) {
          throw new Error(
            `[Game Lab] Missing element: ${selector}`,
          );
        }

        return element;
      }

      const gameStage =
        getRequiredElement<HTMLElement>(
          "#game-stage-shell",
        );

      const stageTitle =
        getRequiredElement<HTMLElement>(
          "#stage-current-game",
        );

      const stageStatus =
        getRequiredElement<HTMLElement>(
          "#stage-status-text",
        );

      const stageContent =
        getRequiredElement<HTMLElement>(
          "#stage-content",
        );

      const closeGame =
        getRequiredElement<HTMLButtonElement>(
          "#close-game",
        );

      const gameTitles: Record<
        GameId,
        string
      > = {
        kuntilanak:
          "KUNTILANAK FLY",

        debugger:
          "DEBUGGER",

        "commit-type":
          "COMMIT TYPE",

        "system-2048":
          "SYSTEM 2048",

        "receh-run":
          "RECEH RUN",

        "warung-defense":
          "WARUNG DEFENSE",

        "stack-trace":
          "STACK TRACE",

        "pixel-panic":
          "PIXEL PANIC",
      };

      const keyboardGames: Record<
        string,
        GameId
      > = {
        "1": "kuntilanak",
        "2": "debugger",
        "3": "commit-type",
        "4": "system-2048",
        "5": "receh-run",
        "6": "warung-defense",
        "7": "stack-trace",
        "8": "pixel-panic",
      };

      const gameNumbers: Record<
        GameId,
        string
      > = {
        kuntilanak: "01",
        debugger: "02",
        "commit-type": "03",
        "system-2048": "04",
        "receh-run": "05",
        "warung-defense": "06",
        "stack-trace": "07",
        "pixel-panic": "08",
      };

      let activeDestroyer:
        Destroyer = null;

      function renderEmptyState() {
        stageContent.innerHTML = `
          <div class="stage-empty">
            <span class="stage-empty-number">
              00
            </span>

            <p class="stage-empty-kicker">
              GAME LAB
            </p>

            <h2>
              PICK SOMETHING.
            </h2>

            <p>
              Your productivity can wait five minutes.
              Probably.
            </p>

            <div class="stage-empty-rule">
              <span></span>

              <small>
                SELECT A GAME ABOVE
              </small>

              <span></span>
            </div>
          </div>
        `;
      }

      function destroyActiveGame() {
        const destroyer =
          activeDestroyer;

        activeDestroyer = null;

        if (
          typeof destroyer !==
          "function"
        ) {
          return;
        }

        try {
          destroyer();
        } catch (error) {
          console.warn(
            "[Game Lab] Cleanup failed.",
            error,
          );
        }
      }

      function showComingSoon(
        gameId: GameId,
      ) {
        stageTitle.textContent =
          gameTitles[gameId];

        stageStatus.textContent =
          "IN DEVELOPMENT";

        stageContent.innerHTML = `
          <div class="stage-empty">
            <span class="stage-empty-number">
              ${gameNumbers[gameId]}
            </span>

            <p class="stage-empty-kicker">
              GAME LAB
            </p>

            <h2>
              COMING SOON.
            </h2>

            <p>
              This game is wired into the arcade,
              but the actual game module is not ready yet.
            </p>

            <div class="stage-empty-rule">
              <span></span>

              <small>
                MODULE UNDER CONSTRUCTION
              </small>

              <span></span>
            </div>
          </div>
        `;

        gameStage.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }

      async function mountLoadedGame(
        gameId: GameId,
        module: GameModule,
      ) {
        if (
          typeof module.mountGame !==
          "function"
        ) {
          throw new Error(
            `${gameId}.ts must export mountGame().`,
          );
        }

        stageContent.innerHTML = "";

        const result =
          await module.mountGame(
            stageContent,
          );

        if (
          typeof result ===
          "function"
        ) {
          activeDestroyer =
            result;
        } else {
          activeDestroyer = null;
        }

        stageStatus.textContent =
          "PLAYING";
      }

      async function launchGame(
        gameId: GameId,
      ) {
        destroyActiveGame();

        stageTitle.textContent =
          gameTitles[gameId];

        stageStatus.textContent =
          "LOADING";

        stageContent.innerHTML = `
          <div class="stage-empty">
            <span class="stage-empty-number">
              ${gameNumbers[gameId]}
            </span>

            <p class="stage-empty-kicker">
              INITIALIZING
            </p>

            <h2>
              LOADING GAME.
            </h2>

            <p>
              Please pretend this is suspense.
            </p>
          </div>
        `;

        gameStage.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });

        try {
          switch (gameId) {
            case "kuntilanak": {
              const module =
                await import(
                  "../games/kuntilanak"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "debugger": {
              const module =
                await import(
                  "../games/debugger"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "commit-type": {
              const module =
                await import(
                  "../games/commit-type"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "system-2048": {
              const module =
                await import(
                  "../games/system-2048"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "receh-run": {
              const module =
                await import(
                  "../games/receh-run"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "warung-defense": {
              const module =
                await import(
                  "../games/warung-defense"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "stack-trace": {
              const module =
                await import(
                  "../games/stack-trace"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            case "pixel-panic": {
              const module =
                await import(
                  "../games/pixel-panic"
                );

              await mountLoadedGame(
                gameId,
                module,
              );

              return;
            }

            default: {
              showComingSoon(
                gameId,
              );

              return;
            }
          }
        } catch (error) {
          console.error(
            `[Game Lab] Failed to load "${gameId}".`,
            error,
          );

          activeDestroyer = null;

          stageStatus.textContent =
            "ERROR";

          stageContent.innerHTML = `
            <div class="stage-empty">
              <span class="stage-empty-number">
                !!
              </span>

              <p class="stage-empty-kicker">
                GAME LOAD ERROR
              </p>

              <h2>
                SOMETHING BROKE.
              </h2>

              <p>
                The game module could not be loaded.
                Check the browser console for the exact error.
              </p>

              <div class="stage-empty-rule">
                <span></span>

                <small>
                  CHECK GAME MODULE
                </small>

                <span></span>
              </div>
            </div>
          `;
        }
      }

      function closeActiveGame() {
        destroyActiveGame();

        stageTitle.textContent =
          "NO GAME SELECTED";

        stageStatus.textContent =
          "READY";

        renderEmptyState();

        document
          .querySelector<HTMLElement>(
            ".arcade-section",
          )
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
      }

      function getGameIdFromElement(
        element: Element,
      ): GameId | null {
        const raw =
          element.getAttribute(
            "data-launch-game",
          );

        if (
          raw === "kuntilanak" ||
          raw === "debugger" ||
          raw === "commit-type" ||
          raw === "system-2048" ||
          raw === "receh-run" ||
          raw === "warung-defense" ||
          raw === "stack-trace" ||
          raw === "pixel-panic"
        ) {
          return raw;
        }

        return null;
      }

      document.addEventListener(
        "click",
        (event) => {
          const target =
            event.target;

          if (
            !(target instanceof Element)
          ) {
            return;
          }

          const launchTarget =
            target.closest<HTMLElement>(
              "[data-launch-game]",
            );

          if (launchTarget) {
            const gameId =
              getGameIdFromElement(
                launchTarget,
              );

            if (gameId) {
              void launchGame(
                gameId,
              );
            }

            return;
          }

          const closeTarget =
            target.closest(
              "#close-game",
            );

          if (closeTarget) {
            closeActiveGame();
          }
        },
      );

      document.addEventListener(
        "keydown",
        (event) => {
          const target =
            event.target;

          if (
            target instanceof
              HTMLInputElement ||
            target instanceof
              HTMLTextAreaElement ||
            target instanceof
              HTMLSelectElement
          ) {
            return;
          }

          if (
            event.key ===
              "Enter" ||
            event.key ===
              " "
          ) {
            if (
              target instanceof
              HTMLElement
            ) {
              const launchTarget =
                target.closest<HTMLElement>(
                  "[data-launch-game]",
                );

              if (launchTarget) {
                const gameId =
                  getGameIdFromElement(
                    launchTarget,
                  );

                if (gameId) {
                  event.preventDefault();

                  void launchGame(
                    gameId,
                  );

                  return;
                }
              }
            }
          }

          if (
            event.key ===
            "Escape"
          ) {
            if (
              typeof activeDestroyer ===
              "function"
            ) {
              closeActiveGame();
            }

            return;
          }

          if (
            target instanceof
            HTMLButtonElement
          ) {
            return;
          }

          const gameId =
            keyboardGames[
              event.key
            ];

          if (gameId) {
            event.preventDefault();

            void launchGame(
              gameId,
            );
          }
        },
      );

      closeGame.setAttribute(
        "aria-label",
        "Close current game",
      );

      const revealSections =
        document.querySelectorAll(
          ".reveal-section",
        );

      const observer =
        new IntersectionObserver(
          (entries) => {
            entries.forEach(
              (entry) => {
                if (
                  entry.isIntersecting
                ) {
                  entry.target.classList.add(
                    "is-visible",
                  );

                  observer.unobserve(
                    entry.target,
                  );
                }
              },
            );
          },
          {
            threshold: 0.08,
            rootMargin:
              "0px 0px -8% 0px",
          },
        );

      revealSections.forEach(
        (section) => {
          observer.observe(
            section,
          );
        },
      );

      const magneticElements =
        document.querySelectorAll(
          ".magnetic",
        );

      magneticElements.forEach(
        (element) => {
          element.addEventListener(
            "pointermove",
            (event) => {
              if (
                window.innerWidth <
                900
              ) {
                return;
              }

              const rect =
                element.getBoundingClientRect();

              const x =
                (event.clientX -
                  rect.left -
                  rect.width / 2) *
                0.07;

              const y =
                (event.clientY -
                  rect.top -
                  rect.height / 2) *
                0.07;

              element.style.setProperty(
                "--mx",
                `${x}px`,
              );

              element.style.setProperty(
                "--my",
                `${y}px`,
              );
            },
          );

          element.addEventListener(
            "pointerleave",
            () => {
              element.style.setProperty(
                "--mx",
                "0px",
              );

              element.style.setProperty(
                "--my",
                "0px",
              );
            },
          );
        },
      );

      const cursorGlow =
        document.querySelector(
          ".cursor-glow",
        );

      if (
        cursorGlow &&
        window.innerWidth >=
          900
      ) {
        window.addEventListener(
          "pointermove",
          (event) => {
            cursorGlow.style.transform =
              `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
          },
        );
      }
    </script>
  </body>
