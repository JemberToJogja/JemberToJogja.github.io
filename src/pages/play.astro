---
const year = new Date().getFullYear();

const games = [
  {
    id: "kuntilanak",
    number: "01",
    title: "KUNTILANAK FLY",
    subtitle: "SIDE-SCROLLING ARCADE",
    description:
      "Fly through the Indonesian night. Dodge trees, utility poles, rooftops, cables, and anything else the night decides to throw at you.",
    category: "ARCADE",
    status: "READY",
    icon: "01",
    featured: true,
  },
  {
    id: "debugger",
    number: "02",
    title: "DEBUGGER",
    subtitle: "CLASSIC MINESWEEPER",
    description:
      "Reveal safe cells, mark suspicious ones, and avoid shipping the bug. Classic Minesweeper mechanics without unnecessary reinvention.",
    category: "PUZZLE",
    status: "READY",
    icon: "DB",
    featured: false,
  },
  {
    id: "commit-type",
    number: "03",
    title: "COMMIT TYPE",
    subtitle: "TYPING CHALLENGE",
    description:
      "Type commit messages before the build gives up on you. Speed matters. Accuracy matters. Unfortunately, both matter.",
    category: "SKILL",
    status: "READY",
    icon: ">_",
    featured: false,
  },
  {
    id: "system-2048",
    number: "04",
    title: "SYSTEM 2048",
    subtitle: "NUMBER PUZZLE",
    description:
      "Merge numbers, build bigger numbers, and slowly lose track of why you started. A familiar puzzle with a developer personality.",
    category: "PUZZLE",
    status: "READY",
    icon: "42",
    featured: false,
  },
];

const upcoming = [
  {
    id: "receh-run",
    number: "05",
    title: "RECEH RUN",
    description:
      "Run through a suspiciously familiar Indonesian neighborhood.",
    status: "READY",
  },
  {
    id: "warung-defense",
    number: "06",
    title: "WARUNG DEFENSE",
    description:
      "Protect the warung. Defend the snacks. Ask questions later.",
    status: "READY",
  },
  {
    id: "stack-trace",
    number: "07",
    title: "STACK TRACE",
    description:
      "Memorize the crash sequence. Replay the nodes. Pretend the bug was someone else's fault.",
    status: "READY",
  },
  {
    id: "pixel-panic",
    number: "08",
    title: "PIXEL PANIC",
    description:
      "Wait for the signal. Hit the correct pixel before your reaction time becomes a public incident.",
    status: "READY",
  },
];

const arcadeSignals = [
  "08 GAMES",
  "00 ACCOUNTS",
  "∞ RETRIES",
];

const yearLabel = String(year);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content="JemberToJogja Game Lab — small browser games, questionable engineering decisions, and absolutely no login screen."
    />

    <meta
      name="theme-color"
      content="#101010"
    />

    <meta
      property="og:title"
      content="Game Lab — JemberToJogja"
    />

    <meta
      property="og:description"
      content="Small browser games built by JemberToJogja."
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://jembertojogja.github.io/play"
    />

    <link
      rel="canonical"
      href="https://jembertojogja.github.io/play"
    />

    <title>
      Game Lab — JemberToJogja
    </title>
  </head>

  <body>
    <div
      class="cursor-glow"
      aria-hidden="true"
    ></div>

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="site-header">
      <div class="header-inner">
        <a
          href="/"
          class="brand"
          aria-label="JemberToJogja home"
        >
          <span class="brand-mark">
            JTJ
          </span>

          <span class="brand-name">
            JEMBERTOJOGJA
          </span>
        </a>

        <nav
          class="desktop-nav"
          aria-label="Primary navigation"
        >
          <a href="/projects">
            Projects
          </a>

          <a href="/members">
            People
          </a>

          <a
            href="https://github.com/JemberToJogja"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>

          <a
            href="/play"
            class="active nav-play"
          >
            Play
          </a>
        </nav>

        <a
          href="/play"
          class="mobile-play"
          aria-label="Game Lab"
        >
          PLAY
        </a>
      </div>
    </header>

    <main>
      <!-- =========================================================
           HERO
      ========================================================== -->

      <section class="hero reveal-section">
        <div
          class="hero-grid-bg"
          aria-hidden="true"
        ></div>

        <div
          class="hero-orbit hero-orbit-one"
          aria-hidden="true"
        ></div>

        <div
          class="hero-orbit hero-orbit-two"
          aria-hidden="true"
        ></div>

        <div class="container">
          <div class="hero-meta">
            <a
              href="/"
              class="back-link"
            >
              ← Back home
            </a>

            <span>
              GAME LAB / {yearLabel}
            </span>
          </div>

          <div class="hero-layout">
            <div class="hero-primary">
              <p class="hero-kicker">
                THE UNNECESSARY DEPARTMENT
              </p>

              <h1 class="hero-title">
                <span>
                  GAMES.
                </span>

                <span>
                  BECAUSE WHY NOT?
                </span>
              </h1>

              <p class="hero-copy">
                Small browser games built for serious
                activities such as avoiding trees,
                hunting bugs, defending warungs,
                tracing crashes, and tapping pixels
                under pressure.
              </p>

              <div class="hero-actions">
                <a
                  href="#arcade"
                  class="hero-button primary magnetic"
                >
                  START PLAYING
                  <span>↓</span>
                </a>

                <a
                  href="/"
                  class="hero-button secondary magnetic"
                >
                  BACK HOME
                </a>
              </div>
            </div>

            <div class="hero-secondary">
              <div class="hero-terminal">
                <div class="terminal-bar">
                  <span></span>
                  <span></span>
                  <span></span>

                  <strong>
                    JTJ://PLAY
                  </strong>
                </div>

                <div class="terminal-body">
                  <span class="terminal-muted">
                    $ ./game-lab
                  </span>

                  <span>
                    loading games...
                  </span>

                  <span>
                    08 modules found
                  </span>

                  <span>
                    00 accounts required
                  </span>

                  <span class="terminal-cursor">
                    _
                  </span>
                </div>
              </div>

              <div class="hero-stats">
                {
                  arcadeSignals.map((signal, index) => (
                    <div
                      class="hero-stat"
                      style={`--delay: ${index * 90}ms`}
                    >
                      <strong>
                        {index === 0
                          ? "08"
                          : index === 1
                            ? "00"
                            : "∞"}
                      </strong>

                      <span>
                        {signal
                          .replace("08 ", "")
                          .replace("00 ", "")
                          .replace("∞ ", "")}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="hero-footer">
            <span>NO LOGIN</span>
            <span>NO BACKEND</span>
            <span>NO LEADERBOARD DRAMA</span>
          </div>
        </div>
      </section>

      <!-- =========================================================
           ARCADE
      ========================================================== -->

      <section
        class="arcade-section reveal-section"
        id="arcade"
      >
        <div class="arcade-grid-bg" aria-hidden="true"></div>

        <div class="container">
          <div class="section-heading reveal-item">
            <div class="section-heading-main">
              <span class="section-number">
                01
              </span>

              <div>
                <p class="section-kicker">
                  CHOOSE YOUR PROBLEM
                </p>

                <h2>
                  GAME ARCADE
                </h2>
              </div>
            </div>

            <p class="section-heading-note">
              Tap a game.
              <br />
              Ignore your responsibilities.
            </p>
          </div>

          <div class="game-grid">
            {
              games.map((game, index) => (
                <article
                  class:list={[
                    "game-card",
                    {
                      "game-card-featured":
                        game.featured,
                    },
                    "reveal-item",
                  ]}
                  data-game-card={game.id}
                  style={`--delay: ${index * 70}ms`}
                >
                  <div class="game-card-top">
                    <span class="game-index">
                      {game.number}
                    </span>

                    <span class="game-category">
                      {game.category}
                    </span>
                  </div>

                  <div class="game-preview">
                    {game.featured ? (
                      <div class="preview-kuntilanak">
                        <div
                          class="preview-stars"
                          aria-hidden="true"
                        >
                          <i></i>
                          <i></i>
                          <i></i>
                          <i></i>
                          <i></i>
                          <i></i>
                        </div>

                        <div class="preview-moon"></div>

                        <div class="preview-wire preview-wire-a"></div>
                        <div class="preview-wire preview-wire-b"></div>

                        <div class="preview-pole"></div>

                        <div class="preview-tree preview-tree-left"></div>
                        <div class="preview-tree preview-tree-right"></div>

                        <div class="preview-ghost">
                          <div class="preview-ghost-head"></div>
                          <div class="preview-ghost-body"></div>

                          <span class="preview-ghost-eye left"></span>
                          <span class="preview-ghost-eye right"></span>
                        </div>

                        <div class="preview-hud">
                          <span>
                            ALT 091
                          </span>

                          <strong>
                            001240
                          </strong>
                        </div>
                      </div>
                    ) : game.id === "debugger" ? (
                      <div class="preview-debugger">
                        <div class="debugger-header">
                          <span>
                            MINES 006
                          </span>

                          <span>
                            TIME 042
                          </span>
                        </div>

                        <div class="debugger-grid">
                          {
                            Array.from({
                              length: 36,
                            }).map(
                              (_, index) => (
                                <span
                                  class:list={[
                                    "debugger-cell",
                                    {
                                      open: [
                                        0,
                                        1,
                                        2,
                                        3,
                                        6,
                                        7,
                                        8,
                                        9,
                                        12,
                                        13,
                                        15,
                                        18,
                                        19,
                                        21,
                                        22,
                                        24,
                                        27,
                                        28,
                                        30,
                                        31,
                                        32,
                                        33,
                                        34,
                                      ].includes(
                                        index,
                                      ),
                                      mine:
                                        index ===
                                        26,
                                      flag:
                                        index ===
                                          10 ||
                                        index ===
                                          16,
                                    },
                                  ]}
                                >
                                  {
                                    index ===
                                    26
                                      ? "X"
                                      : index ===
                                            10 ||
                                          index ===
                                            16
                                        ? "F"
                                        : [
                                              0,
                                              1,
                                              6,
                                              7,
                                              9,
                                              13,
                                              15,
                                              18,
                                              21,
                                              24,
                                              28,
                                              30,
                                              31,
                                              34,
                                            ].includes(
                                              index,
                                            )
                                          ? (index %
                                              3) +
                                            1
                                          : ""
                                  }
                                </span>
                              ),
                            )
                          }
                        </div>
                      </div>
                    ) : game.id === "commit-type" ? (
                      <div class="preview-terminal">
                        <div class="terminal-top">
                          <span></span>
                          <span></span>
                          <span></span>

                          <strong>
                            COMMIT
                          </strong>
                        </div>

                        <div class="terminal-line">
                          <small>01</small>

                          <strong>
                            git commit -m
                          </strong>
                        </div>

                        <div class="terminal-line">
                          <small>02</small>

                          <em>
                            "fix: somehow works"
                          </em>
                        </div>

                        <div class="terminal-line muted">
                          <small>03</small>

                          <span>
                            typing...
                          </span>
                        </div>

                        <div class="terminal-line active">
                          <small>04</small>

                          <span>
                            _ 
                          </span>
                        </div>
                      </div>
                    ) : (
                      <div class="preview-2048">
                        <span>2</span>
                        <span>4</span>
                        <span>8</span>
                        <span>16</span>
                      </div>
                    )}
                  </div>

                  <div class="game-card-content">
                    <p class="game-subtitle">
                      {game.subtitle}
                    </p>

                    <h3>
                      {game.title}
                    </h3>

                    <p class="game-description">
                      {game.description}
                    </p>
                  </div>

                  <div class="game-card-footer">
                    <span class="game-status">
                      <i></i>
                      {game.status}
                    </span>

                    <button
                      type="button"
                      class="play-button magnetic"
                      data-launch-game={game.id}
                    >
                      PLAY
                      <span>↗</span>
                    </button>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================================================
           GAME STAGE
      ========================================================== -->

      <section class="stage-section">
        <div class="container">
          <div
            class="game-stage"
            id="game-stage-shell"
          >
            <div class="stage-window-bar">
              <div class="window-brand">
                <span class="window-dot"></span>
                <span class="window-dot"></span>
                <span class="window-dot"></span>

                <strong>
                  GAME LAB
                </strong>
              </div>

              <div
                class="stage-status"
                id="stage-status-text"
              >
                READY
              </div>
            </div>

            <div class="stage-toolbar">
              <div class="stage-toolbar-main">
                <button
                  id="close-game"
                  type="button"
                  class="stage-back"
                  aria-label="Close current game"
                >
                  ← ARCADE
                </button>

                <span class="stage-slash">
                  /
                </span>

                <strong
                  id="stage-current-game"
                >
                  NO GAME SELECTED
                </strong>
              </div>

              <span class="stage-path">
                JTJ://PLAY
              </span>
            </div>

            <div
              class="stage-content"
              id="stage-content"
            >
              <div class="stage-empty">
                <span class="stage-empty-number">
                  00
                </span>

                <p class="stage-empty-kicker">
                  GAME LAB
                </p>

                <h2>
                  PICK SOMETHING.
                </h2>

                <p>
                  Your productivity can wait five minutes.
                  Probably.
                </p>

                <div class="stage-empty-rule">
                  <span></span>

                  <small>
                    SELECT A GAME ABOVE
                  </small>

                  <span></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           FEATURED KUNTILANAK
      ========================================================== -->

      <section class="featured-section reveal-section">
        <div class="container">
          <div class="feature-topline reveal-item">
            <span class="section-kicker">
              FEATURED / 01
            </span>

            <span>
              INDONESIAN NIGHT SHIFT
            </span>
          </div>

          <div class="feature-layout">
            <div class="feature-art reveal-item">
              <div class="art-grid"></div>

              <div class="art-moon"></div>

              <div class="art-wire art-wire-a"></div>
              <div class="art-wire art-wire-b"></div>

              <div class="art-pole"></div>

              <div class="art-tree art-tree-left"></div>
              <div class="art-tree art-tree-right"></div>

              <div class="art-ghost">
                <div class="art-ghost-hair"></div>
                <div class="art-ghost-head"></div>
                <div class="art-ghost-body"></div>

                <div class="art-ghost-eye left"></div>
                <div class="art-ghost-eye right"></div>
              </div>

              <div class="art-data art-data-top">
                <span>ALTITUDE</span>
                <strong>091</strong>
              </div>

              <div class="art-data art-data-bottom">
                <span>HIGH SCORE</span>
                <strong>001240</strong>
              </div>

              <div class="art-footer">
                <span>
                  01
                </span>

                <strong>
                  KUNTILANAK FLY
                </strong>
              </div>
            </div>

            <div class="feature-content reveal-item">
              <p class="section-kicker">
                SIDE-SCROLLING ARCADE
              </p>

              <h2>
                FLY FIRST.
                <span>
                  THINK LATER.
                </span>
              </h2>

              <p>
                You are a kuntilanak.
                The night is long.
                The route is questionable.
                The obstacles are very real.
              </p>

              <p>
                Stay airborne.
                Dodge Indonesian street scenery.
                Avoid the utility poles.
                Pretend this was always the plan.
              </p>

              <div class="feature-list">
                <div>
                  <span>01</span>

                  <strong>
                    TOUCH TO FLY
                  </strong>
                </div>

                <div>
                  <span>02</span>

                  <strong>
                    AVOID EVERYTHING
                  </strong>
                </div>

                <div>
                  <span>03</span>

                  <strong>
                    CHASE YOUR BEST
                  </strong>
                </div>
              </div>

              <button
                type="button"
                class="wide-button magnetic"
                data-launch-game="kuntilanak"
              >
                PLAY KUNTILANAK FLY
                <span>↗</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           DEBUGGER
      ========================================================== -->

      <section class="debugger-section reveal-section">
        <div class="container">
          <div class="debugger-layout">
            <div class="debugger-content reveal-item">
              <p class="section-kicker">
                CLASSIC PUZZLE
              </p>

              <h2>
                FIND THE BUGS.
                <span>
                  DO NOT BECOME ONE.
                </span>
              </h2>

              <p>
                Debugger keeps the important parts of classic
                Minesweeper: numbered cells, hidden mines,
                flags, timing, and consequences.
              </p>

              <p>
                No fake complexity.
                No strange experimental rules.
                Just the familiar puzzle with a
                JemberToJogja personality.
              </p>

              <button
                type="button"
                class="wide-button magnetic"
                data-launch-game="debugger"
              >
                OPEN DEBUGGER
                <span>↗</span>
              </button>
            </div>

            <div class="minesweeper-showcase reveal-item">
              <div class="mine-topbar">
                <div>
                  <span>
                    MINES
                  </span>

                  <strong>
                    006
                  </strong>
                </div>

                <button
                  type="button"
                  aria-label="Minesweeper preview"
                  tabindex="-1"
                >
                  B
                </button>

                <div>
                  <span>
                    TIME
                  </span>

                  <strong>
                    042
                  </strong>
                </div>
              </div>

              <div class="mine-board">
                {
                  Array.from({
                    length: 36,
                  }).map(
                    (_, index) => (
                      <span
                        class:list={[
                          "mine-tile",
                          {
                            open: [
                              0,
                              1,
                              2,
                              3,
                              6,
                              7,
                              8,
                              9,
                              12,
                              13,
                              15,
                              18,
                              19,
                              21,
                              22,
                              24,
                              27,
                              28,
                              30,
                              31,
                              32,
                              33,
                              34,
                            ].includes(
                              index,
                            ),
                            mine:
                              index ===
                              26,
                            flagged:
                              index === 10 ||
                              index === 16,
                          },
                        ]}
                      >
                        {
                          index === 26
                            ? "X"
                            : index === 10 ||
                                index === 16
                              ? "F"
                              : [
                                    0,
                                    1,
                                    6,
                                    7,
                                    9,
                                    13,
                                    15,
                                    18,
                                    21,
                                    24,
                                    28,
                                    30,
                                    31,
                                    34,
                                  ].includes(
                                    index,
                                  )
                                ? (index %
                                    3) +
                                  1
                                : ""
                        }
                      </span>
                    ),
                  )
                }
              </div>

              <div class="mine-footer">
                CLASSIC MODE
                <span>/</span>
                DON'T CLICK THE WRONG ONE
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           MORE GAMES
      ========================================================== -->

      <section class="upcoming-section reveal-section">
        <div class="container">
          <div class="section-heading reveal-item">
            <div class="section-heading-main">
              <span class="section-number">
                02
              </span>

              <div>
                <p class="section-kicker">
                  CURRENTLY UNNECESSARY
                </p>

                <h2>
                  MORE GAMES?
                </h2>
              </div>
            </div>

            <p class="section-heading-note">
              Apparently.
              <br />
              All four are ready.
            </p>
          </div>

          <div class="upcoming-grid">
            {
              upcoming.map((game, index) => (
                <article
                  class="upcoming-card reveal-item"
                  data-launch-game={game.id}
                  role="button"
                  tabindex="0"
                  aria-label={`Play ${game.title}`}
                  style={`--delay: ${index * 80}ms`}
                >
                  <span class="upcoming-number">
                    {game.number}
                  </span>

                  <div class="upcoming-content">
                    <span class="upcoming-status">
                      {game.status}
                    </span>

                    <h3>
                      {game.title}
                    </h3>

                    <p>
                      {game.description}
                    </p>
                  </div>

                  <span class="upcoming-arrow">
                    ↗
                  </span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================================================
           RULES
      ========================================================== -->

      <section class="rules-section reveal-section">
        <div class="container">
          <div class="rules-card reveal-item">
            <div class="rules-main">
              <p class="section-kicker">
                GAME LAB RULES
              </p>

              <h2>
                WE KEPT
                <span>
                  IT SIMPLE.
                </span>
              </h2>

              <p>
                No profiles.
                No social feed.
                No account setup.
                No twelve-step onboarding flow.
              </p>
            </div>

            <div class="rules-list">
              <div>
                <span>01</span>

                <strong>
                  NO LOGIN
                </strong>
              </div>

              <div>
                <span>02</span>

                <strong>
                  NO PASSWORD
                </strong>
              </div>

              <div>
                <span>03</span>

                <strong>
                  NO BACKEND
                </strong>
              </div>

              <div>
                <span>04</span>

                <strong>
                  JUST PLAY
                </strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           CTA
      ========================================================== -->

      <section class="cta-section">
        <div class="container">
          <div class="cta-card">
            <div>
              <p class="section-kicker">
                HAD ENOUGH?
              </p>

              <h2>
                FAIR.
                <span>
                  GO BUILD SOMETHING.
                </span>
              </h2>
            </div>

