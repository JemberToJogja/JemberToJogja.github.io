    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );

    transition:
      transform
        160ms
        cubic-bezier(
          .2,
          .8,
          .2,
          1
        ),
      background-color
        140ms ease,
      border-color
        140ms ease;
