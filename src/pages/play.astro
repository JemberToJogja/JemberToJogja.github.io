  .art-grid {
    position: absolute;

    inset: 0;
  }

  .art-grid::before,
  .art-grid::after {
    content: "";

    position: absolute;
  }

  .art-grid::before {
    top: 0;
    bottom: 0;
    left: 33.333%;

    width: 1px;

    background: #1f1f1d;

    box-shadow:
      120px 0 #1f1f1d,
      240px 0 #1f1f1d,
      360px 0 #1f1f1d;
  }

  .art-grid::after {
    right: 0;
    left: 0;

    top: 33.333%;

    height: 1px;

    background: #1f1f1d;

    box-shadow:
      0 100px #1f1f1d,
      0 200px #1f1f1d,
      0 300px #1f1f1d;
  }

  .art-moon {
    position: absolute;

    top: 42px;
    right: 34px;

    width: 88px;
    height: 88px;

    background: #e8e0c9;

    border-radius: 50%;

    animation:
      moon-pulse
      4s
      ease-in-out
      infinite;
  }

  .art-wire {
    position: absolute;

    left: -5%;

    width: 110%;
    height: 2px;

    background: #474743;
  }

  .art-wire-a {
    top: 27%;

    transform:
      rotate(
        4deg
      );
  }

  .art-wire-b {
    top: 38%;

    transform:
      rotate(
        -2deg
      );
  }

  .art-pole {
    position: absolute;

    right: 27%;
    bottom: 0;

    width: 8px;
    height: 255px;

    background: #555551;
  }

  .art-pole::before {
    content: "";

    position: absolute;

    right: -42px;
    top: 44px;

    width: 86px;
    height: 6px;

    background: #555551;
  }

  .art-tree {
    position: absolute;

    bottom: -10px;

    width: 28px;

    background: #050505;
  }

  .art-tree::before,
  .art-tree::after {
    content: "";

    position: absolute;

    background: #050505;

    border-radius: 50%;
  }

  .art-tree::before {
    width: 115px;
    height: 84px;

    left: -44px;
    bottom: 115px;
  }

  .art-tree::after {
    width: 91px;
    height: 69px;

    left: -31px;
    bottom: 168px;
  }

  .art-tree-left {
    left: 10%;
    height: 235px;
  }

  .art-tree-right {
    right: 1%;
    height: 175px;
  }

  .art-ghost {
    position: absolute;

    top: 46%;
    left: 50%;

    width: 70px;
    height: 115px;

    transform:
      translate(
