    color: #caff32;
  }

  .game-number {
    color: #65615b;

    font-size: 7px;

    font-weight: 900;

    transition:
      color
      150ms ease;
  }

  .game-row-main strong {
    display: block;

    color: #f4f1e9;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 0.06em;
