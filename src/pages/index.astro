---
const year = new Date().getFullYear();

const games = [
  {
    number: "01",
    title: "KUNTILANAK FLY",
    type: "ARCADE",
    description:
      "Fly. Don't crash. Don't ask why.",
    featured: true,
  },
  {
    number: "02",
    title: "DEBUGGER",
    type: "LOGIC",
    description:
      "Find the bug before the bug finds you.",
  },
  {
    number: "03",
    title: "COMMIT TYPE",
    type: "REFLEX",
    description:
      "Commit faster than your reviewer.",
  },
  {
    number: "04",
    title: "SYSTEM 2048",
    type: "PUZZLE",
    description:
      "Move blocks. Regret everything.",
  },
  {
    number: "05",
    title: "RECEH RUN",
    type: "RUNNER",
    description:
      "Run through the neighborhood.",
  },
  {
    number: "06",
    title: "WARUNG DEFENSE",
    type: "DEFENSE",
    description:
      "Protect the warung at all costs.",
  },
  {
    number: "07",
    title: "STACK TRACE",
    type: "MEMORY",
    description:
      "Remember. Match. Survive.",
  },
  {
    number: "08",
    title: "PIXEL PANIC",
    type: "REACTION",
    description:
      "Tap first. Think later.",
  },
  {
    number: "09",
    title: "ROUTE 404",
    type: "NETWORK",
    description:
      "Route the packet from Jember to Jogja before the network collapses.",
  },
  {
    number: "10",
    title: "BUG HUNT",
    type: "OBSERVATION",
    description:
      "Everything looks correct. Find the lie.",
  },
  {
    number: "11",
    title: "RAM CLASH",
    type: "PHYSICS",
    description:
      "Read. Charge. Impact. Break the balance.",
  },
];

const projects = [
  {
    number: "01",
    name: "LANDCAM",
    description:
      "Mobile controller for a multispectral camera.",
    technologies: "JAVA · FLUTTER · NFC",
    url: "https://github.com/JemberToJogja/LandCam-Multispectral-Camera",
  },
  {
    number: "02",
    name: "TGS CONNECTION",
    description:
      "Prototype connecting GNSS hardware and mobile devices.",
    technologies: "DART · FLUTTER · GNSS",
    url: "https://github.com/JemberToJogja/TGS-Connection-Prototype",
  },
  {
    number: "03",
    name: "WEBGIS",
    description:
      "Web-based geographic information and mapping experiments.",
    technologies: "JAVASCRIPT · GIS · GEOJSON",
    url: "https://github.com/JemberToJogja/WebGIS",
  },
];

const totalGames = games.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="theme-color"
      content="#101010"
    />

    <meta
      name="description"
      content="JemberToJogja — browser games, software experiments, geospatial projects, and questionable ideas."
    />

    <meta
      property="og:title"
      content="JemberToJogja"
    />

    <meta
      property="og:description"
      content="We build. We play."
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://jembertojogja.github.io/"
    />

    <link
      rel="canonical"
      href="https://jembertojogja.github.io/"
    />

    <title>
      JemberToJogja — We build. We play.
    </title>
  </head>

  <body>
    <div class="cursor-glow" aria-hidden="true"></div>

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="site-header">
      <div class="header-inner">
        <a
          href="/"
          class="brand"
          aria-label="JemberToJogja home"
        >
          <span class="brand-mark">
            JTJ
          </span>

          <span class="brand-name">
            JEMBERTOJOGJA
          </span>
        </a>

        <nav
          class="desktop-nav"
          aria-label="Primary navigation"
        >
          <a href="/projects">
            Projects
          </a>

          <a href="/members">
            People
          </a>

          <a
            href="https://github.com/JemberToJogja"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>

          <a
            href="/play"
            class="nav-play"
          >
            Play
          </a>
        </nav>

        <a
          href="/play"
          class="mobile-play"
          aria-label="Open Game Lab"
        >
          PLAY
        </a>
      </div>
    </header>

    <main>
      <!-- =========================================================
           HERO
      ========================================================== -->

      <section class="hero reveal-section">
        <div
          class="hero-grid-bg"
          aria-hidden="true"
        ></div>

        <div
          class="hero-orbit hero-orbit-one"
          aria-hidden="true"
        ></div>

        <div
          class="hero-orbit hero-orbit-two"
          aria-hidden="true"
        ></div>

        <div class="container hero-container">
          <div class="hero-label">
            <span>
              JTJ / {year}
            </span>

            <span>
              SOFTWARE · GAMES · EXPERIMENTS
            </span>
          </div>

          <div class="hero-content">
            <div class="hero-copy-wrap">
              <p class="hero-kicker">
                SMALL TEAM · BIG EXPERIMENTS
              </p>

              <h1 class="hero-title">
                <span class="hero-title-line line-one">
                  WE BUILD.
                </span>

                <span class="hero-title-line line-two">
                  WE PLAY.
                </span>
              </h1>

              <p class="hero-description">
                Software, games, geospatial projects,
                mobile apps, experiments, and whatever
                seemed like a good idea at the time.
              </p>

              <div class="hero-actions">
                <a
                  href="/play"
                  class="button button-primary magnetic"
                >
                  PLAY THE GAMES
                  <span class="button-arrow">→</span>
                </a>

                <a
                  href="/projects"
                  class="button button-secondary magnetic"
                >
                  SEE PROJECTS
                </a>
              </div>
            </div>

            <div class="hero-corner">
              <div class="hero-corner-line"></div>

              <span>
                PRESS PLAY
              </span>

              <strong>
                {String(totalGames).padStart(2, "0")}
              </strong>

              <small>
                GAMES
              </small>
            </div>
          </div>

          <div class="hero-meta">
            <div>
              <span>
                {String(totalGames).padStart(2, "0")}
              </span>

              <small>
                GAMES
              </small>
            </div>

            <div>
              <span>03</span>
              <small>PROJECTS</small>
            </div>

            <div>
              <span>04</span>
              <small>PEOPLE</small>
            </div>

            <div>
              <span>01</span>
              <small>PLAY BUTTON</small>
            </div>
          </div>

          <div class="hero-scroll">
            <span class="scroll-line"></span>

            <span>
              SCROLL TO PLAY
            </span>

            <span class="scroll-arrow">
              ↓
            </span>
          </div>
        </div>
      </section>

      <!-- =========================================================
           GAME LAB
      ========================================================== -->

      <section
        class="game-section reveal-section"
        id="game-lab"
      >
        <div
          class="game-noise"
          aria-hidden="true"
        ></div>

        <div class="container">
          <div class="game-top reveal-item">
            <div>
              <p class="section-kicker">
                GAME LAB
              </p>

              <h2>
                PLAY
                <span>SOMETHING.</span>
              </h2>
            </div>

            <div class="game-total">
              <strong>
                {String(totalGames).padStart(2, "0")}
              </strong>

              <span>
                GAMES
              </span>
            </div>
          </div>

          <a
            href="/play"
            class="featured-game reveal-item magnetic"
          >
            <div class="featured-game-top">
              <span>
                GAME 01
              </span>

              <span>
                ARCADE
              </span>
            </div>

            <div class="featured-game-stage">
              <div
                class="stage-grid"
                aria-hidden="true"
              ></div>

              <div
                class="stage-scanline"
                aria-hidden="true"
              ></div>

              <div
                class="stage-crosshair stage-crosshair-one"
                aria-hidden="true"
              ></div>

              <div
                class="stage-crosshair stage-crosshair-two"
                aria-hidden="true"
              ></div>

              <div class="ghost-character">
                <span class="ghost-head"></span>
                <span class="ghost-body"></span>
                <span class="ghost-eye ghost-eye-one"></span>
                <span class="ghost-eye ghost-eye-two"></span>
                <span class="ghost-foot ghost-foot-one"></span>
                <span class="ghost-foot ghost-foot-two"></span>
                <span class="ghost-foot ghost-foot-three"></span>
              </div>

              <div class="stage-altitude">
                <span>
                  ALTITUDE
                </span>

                <strong>
                  091
                </strong>
              </div>

              <div class="stage-score">
                <span>
                  HIGH SCORE
                </span>

                <strong>
                  001240
                </strong>
              </div>

              <div class="stage-message">
                TAP TO PLAY
              </div>
            </div>

            <div class="featured-game-bottom">
              <div>
                <p>
                  KUNTILANAK FLY
                </p>

                <span>
                  Fly. Don't crash. Don't ask why.
                </span>
              </div>

              <span class="play-arrow">
                PLAY →
              </span>
            </div>
          </a>

          <div class="game-list">
            {
              games.slice(1).map((game, index) => (
                <a
                  href="/play"
                  class="game-row reveal-item magnetic"
                  style={`--delay: ${index * 55}ms`}
                  data-game={game.number}
                >
                  <span class="game-number">
                    {game.number}
                  </span>

                  <div class="game-row-main">
                    <strong>
                      {game.title}
                    </strong>

                    <span>
                      {game.description}
                    </span>
                  </div>

                  <span class="game-type">
                    {game.type}
                  </span>

                  <span class="game-arrow">
                    →
                  </span>
                </a>
              ))
            }
          </div>

          <a
            href="/play"
            class="all-games-button magnetic reveal-item"
          >
            <span>
              OPEN GAME LAB /
              {String(totalGames).padStart(2, "0")} GAMES
            </span>

            <span>
              ↗
            </span>
          </a>
        </div>
      </section>

      <!-- =========================================================
           PROJECTS
      ========================================================== -->

      <section
        class="projects-section reveal-section"
      >
        <div class="container">
          <div class="section-head reveal-item">
            <div>
              <p class="section-kicker">
                OTHER THINGS WE BUILD
              </p>

              <h2>
                PROJECTS
              </h2>
            </div>

            <a
              href="/projects"
              class="text-link"
            >
              ALL PROJECTS →
            </a>
          </div>

          <div class="project-list">
            {
              projects.map((project, index) => (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-row reveal-item magnetic"
                  style={`--delay: ${index * 80}ms`}
                >
                  <span class="project-number">
                    {project.number}
                  </span>

                  <div class="project-main">
                    <strong>
                      {project.name}
                    </strong>

                    <p>
                      {project.description}
                    </p>

                    <span>
                      {project.technologies}
                    </span>
                  </div>

                  <span class="project-arrow">
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================================================
           FIELD / TECHNOGIS
      ========================================================== -->

      <section
        class="field-section reveal-section"
      >
        <div
          class="field-shape field-shape-one"
          aria-hidden="true"
        ></div>

        <div
          class="field-shape field-shape-two"
          aria-hidden="true"
        ></div>

        <div class="container">
          <div class="field-content reveal-item">
            <p class="section-kicker">
              CURRENTLY IN THE FIELD
            </p>

            <h2>
              INTERNING AT
              <span>
                TECHNOGIS.
              </span>
            </h2>

            <p>
              Geospatial technology, GIS, GNSS,
              remote sensing, field equipment,
              mapping, and software that has to work
              outside the browser too.
            </p>

            <a
              href="https://www.technogis.co.id/"
              target="_blank"
              rel="noopener noreferrer"
              class="field-link magnetic"
            >
              TECHNOGIS INDONESIA ↗
            </a>
          </div>

          <div class="field-stats reveal-item">
            <div>
              <span>
                FIELD
              </span>

              <strong>
                GEOSPATIAL
              </strong>
            </div>

            <div>
              <span>
                FOCUS
              </span>

              <strong>
                GIS · GNSS
              </strong>
            </div>

            <div>
              <span>
                MODE
              </span>

              <strong>
                LEARNING
              </strong>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           PEOPLE
      ========================================================== -->

      <section
        class="people-section reveal-section"
      >
        <div
          class="people-grid-art"
          aria-hidden="true"
        >
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="container">
          <div class="people-content reveal-item">
            <p class="section-kicker">
              THE PEOPLE
            </p>

            <h2>
              FOUR
              <span>HUMANS.</span>
            </h2>

            <p>
              Developers, QA, testers, and people who
              somehow agreed to build all of this.
            </p>

            <a
              href="/members"
              class="button button-dark magnetic"
            >
              MEET THE TEAM
              <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- =========================================================
           FINAL CTA
      ========================================================== -->

      <section
        class="final-section reveal-section"
      >
        <div class="container">
          <div class="final-card reveal-item">
            <div
              class="final-lines"
              aria-hidden="true"
            ></div>

            <p class="section-kicker">
              BEFORE YOU LEAVE
            </p>

            <h2>
              PLAY
              <span>FIRST.</span>
            </h2>

            <p>
              The games are probably the most important
              feature on this website anyway.
            </p>

            <div class="final-actions">
              <a
                href="/play"
                class="button button-light magnetic"
              >
                ENTER GAME LAB
                <span>↗</span>
              </a>

              <a
                href="https://github.com/JemberToJogja"
                target="_blank"
                rel="noopener noreferrer"
                class="final-github magnetic"
              >
                GITHUB ↗
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <span class="brand-mark">
              JTJ
            </span>

            <div>
              <strong>
                JEMBERTOJOGJA
              </strong>

              <span>
                SOFTWARE · GAMES · EXPERIMENTS
              </span>
            </div>
          </div>

          <span class="footer-year">
            {year}
          </span>
        </div>

        <div class="footer-bottom">
          <span>
            BUILT WITH ASTRO
          </span>

          <span>
            HOSTED ON GITHUB PAGES
          </span>

          <span>
            {String(totalGames).padStart(2, "0")} GAMES
          </span>

          <span>
            OK BYE_
          </span>
        </div>
      </div>
    </footer>

    <!-- =========================================================
         MOBILE NAV
    ========================================================== -->

    <nav
      class="mobile-nav"
      aria-label="Mobile navigation"
    >
      <a
        href="/"
        class="active"
      >
        <span>⌂</span>
        Home
      </a>

      <a href="/projects">
        <span>＋</span>
        Projects
      </a>

      <a href="/members">
        <span>●</span>
        People
      </a>

      <a
        href="/play"
        class="play-item"
      >
        <span>▶</span>
        Play
      </a>
    </nav>

    <script>
      const revealSections =
        document.querySelectorAll(
          ".reveal-section",
        );

      const observer =
        new IntersectionObserver(
          (entries) => {
            entries.forEach(
              (entry) => {
                if (
                  entry.isIntersecting
                ) {
                  entry.target.classList.add(
                    "is-visible",
                  );

                  observer.unobserve(
                    entry.target,
                  );
                }
              },
            );
          },
          {
            threshold: 0.12,
            rootMargin:
              "0px 0px -10% 0px",
          },
        );

      revealSections.forEach(
        (section) => {
          observer.observe(
            section,
          );
        },
      );

      const magneticElements =
        document.querySelectorAll(
          ".magnetic",
        );

      magneticElements.forEach(
        (element) => {
          element.addEventListener(
            "pointermove",
            (event) => {
              if (
                window.innerWidth < 900
              ) {
                return;
              }

              const rect =
                element.getBoundingClientRect();

              const x =
                (event.clientX -
                  rect.left -
                  rect.width / 2) *
                0.08;

              const y =
                (event.clientY -
                  rect.top -
                  rect.height / 2) *
                0.08;

              element.style.setProperty(
                "--mx",
                `${x}px`,
              );

              element.style.setProperty(
                "--my",
                `${y}px`,
              );
            },
          );

          element.addEventListener(
            "pointerleave",
            () => {
              element.style.setProperty(
                "--mx",
                "0px",
              );

              element.style.setProperty(
                "--my",
                "0px",
              );
            },
          );
        },
      );

      const cursorGlow =
        document.querySelector(
          ".cursor-glow",
        );

      if (
        cursorGlow &&
        window.innerWidth >=
          900
      ) {
        window.addEventListener(
          "pointermove",
          (event) => {
            cursorGlow.style.transform =
              `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
          },
        );
      }

      const gameRows =
        document.querySelectorAll(
          ".game-row",
        );

      gameRows.forEach(
        (row) => {
          row.addEventListener(
            "pointerenter",
            () => {
              row.classList.add(
                "is-hovered",
              );
            },
          );

          row.addEventListener(
            "pointerleave",
            () => {
              row.classList.remove(
                "is-hovered",
              );
            },
          );
        },
      );
    </script>
  </body>
</html>

<style>
  /* =============================================================
     RESET / BASE
  ============================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #101010;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;

    background: #f4f1e9;
    color: #111;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(::selection) {
    background: #111;
    color: #f4f1e9;
  }

  .container {
    width: min(
      calc(100% - 28px),
      1100px
    );

    margin-inline: auto;
  }

  .section-kicker,
  .hero-label,
  .hero-meta,
  .game-top,
  .featured-game-top,
  .game-type,
  .project-number,
  .project-main > span,
  .field-stats,
  .footer-bottom,
  .footer-year {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  .section-kicker {
    margin: 0 0 10px;

    color: #77736b;

    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.13em;
  }

  .cursor-glow {
    position: fixed;

    top: 0;
    left: 0;
    z-index: 200;

    width: 24px;
    height: 24px;

    pointer-events: none;

    border-radius: 50%;

    background: rgba(
      255,
      255,
      255,
      0.08
    );

    filter: blur(3px);

    transform:
      translate3d(
        -50px,
        -50px,
        0
      );

    transition:
      transform
      80ms linear,
      opacity
      180ms ease;

    opacity: 0;

    mix-blend-mode: difference;
  }

  @media (min-width: 900px) {
    .cursor-glow {
      opacity: 1;
    }
  }

  /* =============================================================
     HEADER
  ============================================================= */

  .site-header {
    position: sticky;

    top: 0;
    z-index: 100;

    background:
      rgba(
        16,
        16,
        16,
        0.96
      );

    color: #f4f1e9;

    border-bottom:
      1px
      solid
      #2a2a2a;

    backdrop-filter:
      blur(12px);
  }

  .header-inner {
    width: min(
      calc(100% - 20px),
      1100px
    );

    min-height: 60px;

    margin-inline: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 14px;
  }

  .brand {
    display: flex;

    align-items: center;

    gap: 9px;
  }

  .brand-mark {
    width: 33px;
    height: 33px;

    display: grid;

    place-items: center;

    background: #f4f1e9;
    color: #111;

    font-size: 9px;
    font-weight: 950;
    letter-spacing: -0.05em;

    transition:
      transform
      180ms ease,
      background-color
      180ms ease;
  }

  .brand:hover .brand-mark {
    transform:
      rotate(-5deg)
      scale(1.04);

    background: #dce5d3;
  }

  .brand-name {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.11em;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-play {
    padding:
      9px
      11px;

    border:
      1px
      solid
      #494949;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  /* =============================================================
     COMMON BUTTONS
  ============================================================= */

  .button {
    min-height: 48px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    padding:
      0
      16px;

    border:
      1px
      solid
      transparent;

    font-size: 9px;

    font-weight: 950;

    letter-spacing: 0.08em;

    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );

    transition:
      transform
      160ms cubic-bezier(.2,.8,.2,1),
      background-color
      140ms ease,
      border-color
      140ms ease,
      color
      140ms ease;
  }

  .button-primary {
    background: #111;
    color: #fff;
  }

  .button-primary:hover {
    background: #2a2a2a;
  }

  .button-secondary {
    border-color: #aaa69d;
    background: transparent;
  }

  .button-secondary:hover {
    background: #dedad1;
    border-color: #111;
  }

  .button-dark {
    background: #111;
    color: #f4f1e9;
  }

  .button-dark:hover {
    background: #292929;
  }

  .button-light {
    background: #f4f1e9;
    color: #111;
  }

  .button-light:hover {
    background: #fff;
  }

  .button-arrow {
    display: inline-block;

    transition:
      transform
      140ms ease;
  }

  .button:hover .button-arrow {
    transform:
      translateX(4px);
  }

  /* =============================================================
     HERO
  ============================================================= */

  .hero {
    position: relative;

    overflow: hidden;

    min-height:
      calc(
        100svh - 60px
      );

    display: flex;
    align-items: center;

    background: #f4f1e9;

    border-bottom:
      1px
      solid
      #d0cbc2;
  }

  .hero-grid-bg {
    position: absolute;

    inset: 0;

    background-image:
      linear-gradient(
        rgba(
          17,
          17,
          17,
          0.045
        )
        1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(
          17,
          17,
          17,
          0.045
        )
        1px,
        transparent 1px
      );

    background-size:
      28px
      28px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 85%
      );

    pointer-events: none;

    animation:
      hero-grid-drift
      14s
      linear
      infinite;
  }

  .hero-orbit {
    position: absolute;

    border:
      1px
      solid
      rgba(
        17,
        17,
        17,
        0.08
      );

    border-radius: 50%;

    pointer-events: none;

    animation:
      orbit-float
      8s
      ease-in-out
      infinite;
  }

  .hero-orbit-one {
    width: 280px;
    height: 280px;

    top: 4%;
    right: -150px;
  }

  .hero-orbit-two {
    width: 180px;
    height: 180px;

    top: 16%;
    right: -100px;

    animation-delay:
      -2s;
  }

  .hero-container {
    position: relative;

    z-index: 2;
  }

  .hero-label {
    min-height: 42px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

    color: #77736b;

    border-bottom:
      1px
      solid
      #d0cbc2;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.1em;
  }

  .hero-content {
    padding:
      58px
      0
      38px;

    display: grid;

    gap: 30px;
  }

  .hero-kicker {
    margin:
      0
      0
      15px;

    color: #77736b;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: 0.12em;
  }

  .hero-title {
    margin: 0;

    font-size:
      clamp(
        66px,
        19vw,
        130px
      );

    font-weight: 950;

    line-height: 0.79;

    letter-spacing: -0.095em;

    overflow: hidden;
  }

  .hero-title-line {
    display: block;

    opacity: 0;

    transform:
      translateY(110%)
      rotate(4deg);

    animation:
      hero-line-in
      900ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .line-two {
    color: #77736b;

    animation-delay:
      120ms;
  }

  .hero-description {
    max-width: 560px;

    margin:
      22px
      0
      0;

    color: #5c5851;

    font-size: 13px;

    line-height: 1.7;

    opacity: 0;

    transform:
      translateY(18px);

    animation:
      fade-up
      700ms
      320ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-actions {
    display: grid;

    gap: 8px;

    margin-top: 24px;

    opacity: 0;

    transform:
      translateY(14px);

    animation:
      fade-up
      700ms
      420ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-corner {
    width: 150px;

    justify-self: end;

    display: grid;

    grid-template-columns:
      1fr
      auto;

    grid-template-rows:
      auto
      auto
      auto;

    gap: 6px 8px;

    padding: 14px;

    border:
      1px
      solid
      #c8c3ba;

    background:
      rgba(
        244,
        241,
        233,
        0.75
      );

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    transform:
      rotate(-3deg);

    opacity: 0;

    animation:
      corner-in
      800ms
      500ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-corner-line {
    grid-column:
      1 / -1;

    width: 24px;
    height: 2px;

    background: #111;
  }

  .hero-corner span {
    color: #77736b;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.09em;
  }

  .hero-corner strong {
    grid-row:
      2 / 4;

    grid-column: 2;

    align-self: center;

    font-size: 46px;

    line-height: 0.8;

    letter-spacing: -0.08em;
  }

  .hero-corner small {
    grid-column: 1;

    color: #77736b;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.1em;
  }

  .hero-meta {
    display: grid;

    grid-template-columns:
      repeat(
        4,
        1fr
      );

    border-top:
      1px
      solid
      #d0cbc2;
  }

  .hero-meta div {
    min-height: 56px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    gap: 3px;

    padding:
      10px
      0;

    animation:
      meta-in
      700ms
      cubic-bezier(.16,1,.3,1)
      both;

    opacity: 0;
  }

  .hero-meta div:nth-child(1) {
    animation-delay:
      520ms;
  }

  .hero-meta div:nth-child(2) {
    animation-delay:
      600ms;
  }

  .hero-meta div:nth-child(3) {
    animation-delay:
      680ms;
  }

  .hero-meta div:nth-child(4) {
    animation-delay:
      760ms;
  }

  .hero-meta div + div {
    padding-left: 10px;

    border-left:
      1px
      solid
      #d0cbc2;
  }

  .hero-meta span {
    font-size: 13px;

    font-weight: 950;

    letter-spacing: -0.03em;
  }

  .hero-meta small {
    color: #77736b;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.07em;
  }

  .hero-scroll {
    display: flex;

    align-items: center;

    gap: 9px;

    margin-top: 16px;

    color: #77736b;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.1em;
  }

  .scroll-line {
    width: 34px;
    height: 1px;

    background: #aaa69d;

    animation:
      scroll-pulse
      1.8s
      ease-in-out
      infinite;
  }

  .scroll-arrow {
    animation:
      scroll-bounce
      1.5s
      ease-in-out
      infinite;
  }

  /* =============================================================
     GAME
  ============================================================= */

  .game-section {
    position: relative;

    overflow: hidden;

    padding:
      54px
      0
      58px;

    background: #101010;

    color: #f4f1e9;
  }

  .game-noise {
    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: 0.14;

    background-image:
      radial-gradient(
        rgba(
          255,
          255,
          255,
          .9
        )
        .5px,
        transparent .5px
      );

    background-size:
      5px
      5px;

    animation:
      noise-shift
      .35s
      steps(2)
      infinite;
  }

  .game-section .container {
    position: relative;
    z-index: 2;
  }

  .game-top {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 18px;

    margin-bottom: 19px;
  }

  .game-top h2 {
