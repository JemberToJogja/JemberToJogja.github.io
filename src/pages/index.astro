  .all-games-button {
    min-height: 52px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-top: 15px;

    padding:
      0
      16px;

    background: #f4f1e9;

    color: #111;

    font-size: 9px;

    font-weight: 950;

    letter-spacing: 0.09em;

    transform:
      translate3d(
