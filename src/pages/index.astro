    font-size:
      clamp(
        42px,
        12vw,
        84px
      );

    font-weight: 950;

    line-height: 0.82;

    letter-spacing: -0.085em;
  }

  .game-top h2 span {
    display: block;

    color: #77736b;
  }

  .game-total {
    display: grid;

    justify-items: end;

    gap: 3px;
  }

  .game-total strong {
    font-size: 42px;

    font-weight: 950;

    line-height: 0.8;

    letter-spacing: -0.08em;
  }

  .game-total span {
    color: #6b6761;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.11em;
  }

  .featured-game {
    display: block;

    overflow: hidden;

    border:
      1px
      solid
      #343434;

    background: #181818;

    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );

    transition:
      transform
      180ms cubic-bezier(.2,.8,.2,1),
      border-color
      180ms ease;
  }

  .featured-game:hover {
    border-color:
      #5a5a5a;
  }

  .featured-game-top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 12px;

    border-bottom:
      1px
      solid
      #2f2f2f;

    color: #78736d;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .featured-game-stage {
    position: relative;

    min-height: 280px;

    overflow: hidden;

    background: #202020;
  }

  .stage-grid {
    position: absolute;

    inset: 0;

    background-image:
      linear-gradient(
        rgba(
          255,
          255,
          255,
          .05
        )
        1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(
          255,
          255,
          255,
          .05
        )
        1px,
        transparent 1px
      );

    background-size:
      22px
      22px;

    transform:
      translateY(0);

    animation:
      stage-grid-move
      7s
      linear
      infinite;
  }

  .stage-scanline {
    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(
          255,
          255,
          255,
          .06
        )
        50%,
        transparent 100%
      );

    background-size:
      100%
      18px;

    animation:
      scanline
      4s
      linear
      infinite;
  }

  .stage-crosshair {
    position: absolute;

    width: 14px;
    height: 14px;

    border:
      1px
      solid
      #5b5b5b;
  }

  .stage-crosshair::before,
  .stage-crosshair::after {
    content: "";

    position: absolute;

    background: #5b5b5b;
  }

  .stage-crosshair::before {
    top: 50%;

    left: -5px;
    right: -5px;

    height: 1px;

    transform:
      translateY(-50%);
  }

  .stage-crosshair::after {
    top: -5px;
    bottom: -5px;

    left: 50%;

    width: 1px;

    transform:
      translateX(-50%);
  }

  .stage-crosshair-one {
    top: 22px;
    left: 20px;
  }

  .stage-crosshair-two {
    right: 20px;
    bottom: 22px;
  }

  .ghost-character {
    position: absolute;

    left: 50%;
    top: 48%;

    width: 84px;
    height: 84px;

    transform:
      translate(
        -50%,
        -50%
      );

    animation:
      ghost-float
      2.4s
      ease-in-out
      infinite;
  }

  .ghost-head {
    position: absolute;

    left: 10px;
    right: 10px;
    top: 8px;

    height: 52px;

    border-radius:
      45%
      45%
      35%
      35%;

    background: #f4f1e9;
  }

  .ghost-body {
    position: absolute;

    left: 7px;
    right: 7px;
    top: 34px;

    height: 32px;

    background: #f4f1e9;

    clip-path:
      polygon(
        0 0,
        100% 0,
        100% 82%,
        84% 100%,
        68% 82%,
        50% 100%,
        32% 82%,
        16% 100%,
        0 82%
      );
  }

  .ghost-eye {
    position: absolute;

    top: 28px;

    width: 9px;
    height: 12px;

    background: #202020;

    border-radius: 50%;
  }

  .ghost-eye-one {
    left: 29px;
  }

  .ghost-eye-two {
    right: 29px;
  }

  .ghost-foot {
    position: absolute;

    bottom: 5px;

    width: 14px;
    height: 10px;

    border-radius: 50%;

    background: #f4f1e9;
  }

  .ghost-foot-one {
    left: 13px;
  }

  .ghost-foot-two {
    left: 35px;
  }

  .ghost-foot-three {
    right: 13px;
  }

  .stage-altitude,
  .stage-score {
    position: absolute;

    display: grid;

    gap: 3px;

    color: #74706a;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  .stage-altitude {
    top: 19px;
    right: 19px;
  }

  .stage-score {
    left: 19px;
    bottom: 19px;
  }

  .stage-altitude span,
  .stage-score span {
    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.1em;
  }

  .stage-altitude strong,
  .stage-score strong {
    color: #d8d4cb;

    font-size: 9px;

    letter-spacing: 0.08em;
  }

  .stage-message {
    position: absolute;

    left: 50%;
    bottom: 19px;

    transform:
      translateX(-50%);

    color: #f4f1e9;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: 0.1em;

    animation:
      message-blink
      1.4s
      steps(2)
      infinite;
  }

  .featured-game-bottom {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 14px;

    padding: 17px;
  }

  .featured-game-bottom p {
    margin: 0;

    font-size: 28px;

    font-weight: 950;

    line-height: 0.88;

    letter-spacing: -0.065em;
  }

  .featured-game-bottom span {
    display: block;

    margin-top: 7px;

    color: #8d8982;

    font-size: 10px;

    line-height: 1.45;
  }

  .play-arrow {
    flex:
      0
      0
      auto;

    margin: 0 !important;

    color: #f4f1e9 !important;

    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace !important;

    font-size: 8px !important;

    font-weight: 900 !important;

    letter-spacing: 0.08em;

    animation:
      arrow-pulse
      1.8s
      ease-in-out
      infinite;
  }

  .game-list {
    margin-top: 8px;

    border-top:
      1px
      solid
      #2a2a2a;
  }

  .game-row {
    position: relative;

    display: grid;

    grid-template-columns:
      28px
      1fr
      auto;

    gap: 10px;

    padding:
      14px
      0;

    border-bottom:
      1px
      solid
      #2a2a2a;

    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );

    transition:
      transform
      180ms cubic-bezier(.2,.8,.2,1),
      padding-left
      180ms ease,
      background-color
      180ms ease;
