---
const year = new Date().getFullYear();

const projects = [
  {
    number: "01",
    name: "LANDCAM",
    repo: "LandCam-Multispectral-Camera",
    description:
      "A mobile controller for a multispectral camera. Because walking to the camera is apparently no longer acceptable.",
    technologies: ["JAVA", "FLUTTER", "NFC", "WI-FI"],
    status: "ACTIVE",
    url: "https://github.com/JemberToJogja/LandCam-Multispectral-Camera",
    mark: "LC",
  },
  {
    number: "02",
    name: "TGS CONNECTION",
    repo: "TGS-Connection-Prototype",
    description:
      "A small prototype connecting GNSS hardware and phones through modern mobile communication.",
    technologies: ["DART", "FLUTTER", "GNSS", "BLUETOOTH"],
    status: "PROTOTYPE",
    url: "https://github.com/JemberToJogja/TGS-Connection-Prototype",
    mark: "TG",
  },
  {
    number: "03",
    name: "WEBGIS",
    repo: "WebGIS",
    description:
      "Maps, geographic data, and a suspicious amount of zooming in and out.",
    technologies: ["JAVASCRIPT", "GIS", "GEOJSON", "MAPPING"],
    status: "PROJECT",
    url: "https://github.com/JemberToJogja/WebGIS",
    mark: "WG",
  },
];

const domains = [
  "GEOSPATIAL",
  "SOFTWARE",
  "GNSS",
  "MOBILE",
  "GIS",
  "CAMERAS",
];

const gameHighlights = [
  {
    number: "01",
    title: "KUNTILANAK FLY",
    type: "ARCADE",
  },
  {
    number: "04",
    title: "SYSTEM 2048",
    type: "PUZZLE",
  },
  {
    number: "07",
    title: "STACK TRACE",
    type: "MEMORY",
  },
  {
    number: "08",
    title: "PIXEL PANIC",
    type: "REACTION",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content="JemberToJogja — software, geospatial technology, GNSS, mobile apps, cameras, experiments, and browser games."
    />

    <meta
      name="theme-color"
      content="#101010"
    />

    <meta
      property="og:title"
      content="JemberToJogja"
    />

    <meta
      property="og:description"
      content="We build things that sometimes work."
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://jembertojogja.github.io/"
    />

    <link
      rel="canonical"
      href="https://jembertojogja.github.io/"
    />

    <title>
      JemberToJogja — We build things that sometimes work.
    </title>
  </head>

  <body>
    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="site-header">
      <div class="header-inner">
        <a
          href="/"
          class="brand"
          aria-label="JemberToJogja home"
        >
          <span class="brand-mark">
            JTJ
          </span>

          <span class="brand-name">
            JEMBERTOJOGJA
          </span>
        </a>

        <nav
          class="desktop-nav"
          aria-label="Primary navigation"
        >
          <a
            href="/projects"
          >
            Projects
          </a>

          <a
            href="/members"
          >
            People
          </a>

          <a
            href="/play"
          >
            Play
          </a>

          <a
            href="https://github.com/JemberToJogja"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </nav>

        <a
          href="https://github.com/JemberToJogja"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-github"
          aria-label="Open JemberToJogja on GitHub"
        >
          ↗
        </a>
      </div>
    </header>

    <main>
      <!-- =========================================================
           HERO
      ========================================================== -->

      <section class="hero">
        <div class="container">
          <div class="hero-topline">
            <span>
              JEMBERTOJOGJA / {year}
            </span>

            <span>
              SOFTWARE · FIELD · EXPERIMENT
            </span>
          </div>

          <div class="hero-grid">
            <div class="hero-main">
              <p class="eyebrow">
                SMALL TEAM.
                QUESTIONABLE IDEAS.
              </p>

              <h1>
                We build things
                <span>
                  that sometimes work.
                </span>
              </h1>

              <p class="hero-copy">
                Software, maps, GNSS, cameras, mobile apps,
                experiments, and whatever seemed like a
                good idea at the time.
              </p>

              <div class="hero-actions">
                <a
                  href="/projects"
                  class="button button-dark"
                >
                  Explore projects
                  <span>↗</span>
                </a>

                <a
                  href="/play"
                  class="button button-outline"
                >
                  Open Game Lab
                </a>
              </div>
            </div>

            <div class="hero-side">
              <div class="hero-card hero-card-dark">
                <div class="hero-card-label">
                  <span>
                    CURRENT STATUS
                  </span>

                  <span class="status-live">
                    ● LIVE
                  </span>
                </div>

                <div class="hero-card-row">
                  <span>
                    PROJECTS
                  </span>

                  <strong>
                    03
                  </strong>
                </div>

                <div class="hero-card-row">
                  <span>
                    GAME LAB
                  </span>

                  <strong>
                    08
                  </strong>
                </div>

                <div class="hero-card-row">
                  <span>
                    INTERNSHIP
                  </span>

                  <strong>
                    TECHNOGIS
                  </strong>
                </div>

                <div class="hero-card-row last">
                  <span>
                    BACKEND
                  </span>

                  <strong>
                    NOPE
                  </strong>
                </div>
              </div>

              <div class="hero-card hero-card-light">
                <span class="hero-card-index">
                  01 / 03
                </span>

                <p>
                  Built as a static site.
                  Designed for people who arrived
                  from Instagram and have approximately
                  seven seconds of patience.
                </p>
              </div>
            </div>
          </div>

          <div class="hero-bottomline">
            <span>
              NO LOGIN
            </span>

            <span>
              NO DATABASE
            </span>

            <span>
              NO ADMIN PANEL
            </span>

            <span>
              JUST THE WORK
            </span>
          </div>
        </div>
      </section>

      <!-- =========================================================
           INTRO
      ========================================================== -->

      <section class="intro-section">
        <div class="container intro-grid">
          <div class="section-marker">
            <span>
              01
            </span>

            <span>
              WHAT WE DO
            </span>
          </div>

          <div class="intro-content">
            <h2>
              Software gets more interesting
              when it has to leave the screen.
            </h2>

            <p>
              Our projects sit somewhere between software
              engineering and the physical world:
              geospatial systems, GNSS, field hardware,
              cameras, mobile applications, and mapping.
            </p>

            <div class="domain-row">
              {
                domains.map(
                  (domain) => (
                    <span>
                      {domain}
                    </span>
                  ),
                )
              }
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           PROJECTS
      ========================================================== -->

      <section class="projects-section">
        <div class="container">
          <div class="section-header">
            <div>
              <p class="section-kicker">
                SELECTED WORK
              </p>

              <h2>
                Projects.
              </h2>
            </div>

            <a
              href="/projects"
              class="section-link"
            >
              View all projects
              <span>↗</span>
            </a>
          </div>

          <div class="projects-stack">
            {
              projects.map(
                (project) => (
                  <article
                    class="project-card"
                  >
                    <div class="project-number">
                      {project.number}
                    </div>

                    <div class="project-visual">
                      {project.mark}
                    </div>

                    <div class="project-body">
                      <div class="project-meta">
                        <span>
                          {project.repo}
                        </span>

                        <span>
                          {project.status}
                        </span>
                      </div>

                      <h3>
                        {project.name}
                      </h3>

                      <p>
                        {project.description}
                      </p>

                      <div class="project-tech">
                        {
                          project.technologies.map(
                            (technology) => (
                              <span>
                                {technology}
                              </span>
                            ),
                          )
                        }
                      </div>

                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-action"
                      >
                        OPEN REPOSITORY
                        <span>↗</span>
                      </a>
                    </div>
                  </article>
                ),
              )
            }
          </div>
        </div>
      </section>

      <!-- =========================================================
           INTERNSHIP
      ========================================================== -->

      <section class="internship-section">
        <div class="container">
          <div class="internship-grid">
            <div class="internship-main">
              <p class="section-kicker light">
                CURRENTLY LEARNING IN THE FIELD
              </p>

              <h2>
                Interning at
                <span>
                  TechnoGIS Indonesia.
                </span>
              </h2>

              <p class="internship-copy">
                This is the part where the projects get
                closer to actual field problems:
                geospatial technology, mapping,
                survey equipment, GNSS, cameras,
                and software connected to the physical world.
              </p>

              <a
                href="https://www.technogis.co.id/"
                target="_blank"
                rel="noopener noreferrer"
                class="company-link"
              >
                Visit TechnoGIS Indonesia
                <span>↗</span>
              </a>
            </div>

            <div class="internship-side">
              <div class="company-mark">
                TG
              </div>

              <div class="company-details">
                <span>
                  COMPANY
                </span>

                <strong>
                  TECHNOGIS INDONESIA
                </strong>
              </div>

              <div class="company-details">
                <span>
                  FIELD
                </span>

                <strong>
                  GEOSPATIAL TECHNOLOGY
                </strong>
              </div>

              <div class="company-details">
                <span>
                  INTERESTS
                </span>

                <strong>
                  GIS · GNSS · REMOTE SENSING
                </strong>
              </div>

              <div class="company-details last">
                <span>
                  WEBSITE
                </span>

                <strong>
                  TECHNOGIS.CO.ID ↗
                </strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           PEOPLE TEASER
           No member information here.
      ========================================================== -->

      <section class="people-teaser">
        <div class="container">
          <div class="people-grid">
            <div>
              <p class="section-kicker">
                THE PEOPLE
              </p>

              <h2>
                Four humans.
                <span>
                  One website.
                </span>
              </h2>
            </div>

            <div>
              <p class="people-copy">
                The people behind the code,
                documentation, testing, experiments,
                and occasionally questionable decisions
                have their own page.
              </p>

              <a
                href="/members"
                class="button button-light"
              >
                Meet the team
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           GAME LAB
      ========================================================== -->

      <section class="game-section">
        <div class="container">
          <div class="game-frame">
            <div class="game-header">
              <div>
                <p class="section-kicker">
                  THE UNNECESSARY DEPARTMENT
                </p>

                <h2>
                  We made games.
                  <span>
                    Obviously.
                  </span>
                </h2>
              </div>

              <div class="game-count">
                <strong>
                  08
                </strong>

                <span>
                  GAMES
                </span>
              </div>
            </div>

            <div class="game-grid">
              {
                gameHighlights.map(
                  (game) => (
                    <div class="game-item">
                      <span>
                        {game.number}
                      </span>

                      <div>
                        <strong>
                          {game.title}
                        </strong>

                        <small>
                          {game.type}
                        </small>
                      </div>
                    </div>
                  ),
                )
              }
            </div>

            <div class="game-footer">
              <p>
                Fast. Static. Touch-friendly.
                Mildly unnecessary.
              </p>

              <a
                href="/play"
                class="button button-light"
              >
                Enter Game Lab
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           PRINCIPLES
      ========================================================== -->

      <section class="principles-section">
        <div class="container">
          <div class="section-header">
            <div>
              <p class="section-kicker">
                HOW WE LIKE THIS SITE
              </p>

              <h2>
                Keep it simple.
              </h2>
            </div>
          </div>

          <div class="principles-grid">
            <article>
              <span>
                01
              </span>

              <h3>
                STATIC
              </h3>

              <p>
                Astro builds the pages ahead of time.
                GitHub Pages serves the result.
                That's it.
              </p>
            </article>

            <article>
              <span>
                02
              </span>

              <h3>
                FAST
              </h3>

              <p>
                Small pages, no unnecessary runtime,
                no loading ceremony, no dashboard
                pretending to be a homepage.
              </p>
            </article>

            <article>
              <span>
                03
              </span>

              <h3>
                OPEN
              </h3>

              <p>
                The work lives in public repositories.
                The website is simply the front door.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- =========================================================
           CTA
      ========================================================== -->

      <section class="cta-section">
        <div class="container">
          <div class="cta-card">
            <div>
              <p class="section-kicker">
                THAT'S ENOUGH INTERNET
              </p>

              <h2>
                Go look at the code.
              </h2>

              <p>
                Or play a game first.
                We are not your manager.
              </p>
            </div>

            <div class="cta-actions">
              <a
                href="https://github.com/JemberToJogja"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-dark"
              >
                GitHub
                <span>↗</span>
              </a>

              <a
                href="/projects"
                class="button button-outline-dark"
              >
                Projects
              </a>

              <a
                href="/play"
                class="button button-outline-dark"
              >
                Play
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <span class="brand-mark">
            JTJ
          </span>

          <div>
            <strong>
              JEMBERTOJOGJA
            </strong>

            <small>
              SOFTWARE / FIELD / EXPERIMENT
            </small>
          </div>
        </div>

        <p>
          Built with Astro.
          Hosted on GitHub Pages.
          Currently interning at TechnoGIS Indonesia.
        </p>

        <span class="footer-end">
          {year} / OK BYE_
        </span>
      </div>
    </footer>

    <!-- =========================================================
         MOBILE NAV
    ========================================================== -->

    <nav
      class="mobile-nav"
      aria-label="Mobile navigation"
    >
      <a
        href="/"
        class="active"
        aria-label="Home"
      >
        <span>⌂</span>
        Home
      </a>

      <a
        href="/projects"
        aria-label="Projects"
      >
        <span>＋</span>
        Projects
      </a>

      <a
        href="/members"
        aria-label="People"
      >
        <span>●</span>
        People
      </a>

      <a
        href="/play"
        aria-label="Play"
      >
        <span>▶</span>
        Play
      </a>
    </nav>
  </body>
</html>

<style>
  /* =============================================================
     BASE
  ============================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #111111;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #efede7;
    color: #111111;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button) {
    font: inherit;
  }

  :global(::selection) {
    background: #111111;
    color: #efede7;
  }

  .container {
    width: min(
      calc(100% - 28px),
      1180px
    );
    margin-inline: auto;
  }

  .section-kicker,
  .hero-topline,
  .hero-bottomline,
  .section-marker,
  .project-meta,
  .project-tech,
  .company-details,
  .game-item,
  .game-count,
  .footer-grid,
  .hero-card-label,
  .hero-card-row {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  .section-kicker {
    margin: 0 0 10px;
    color: #6b6861;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1.3;
  }

  .section-kicker.light {
    color: #8c8982;
  }

  /* =============================================================
     HEADER
  ============================================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #111111;
    color: #f2f0e9;
    border-bottom: 1px solid #2d2d2d;
  }

  .header-inner {
    width: min(
      calc(100% - 20px),
      1180px
    );
    min-height: 62px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    background: #f2f0e9;
    color: #111111;
    font-size: 9px;
    font-weight: 950;
    letter-spacing: -0.04em;
  }

  .brand-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.11em;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-github {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid #444444;
    color: #f2f0e9;
    font-size: 16px;
  }

  /* =============================================================
     BUTTONS
  ============================================================= */

  .button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 15px;
    border: 1px solid transparent;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      transform 120ms ease,
      background-color 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button-dark {
    background: #111111;
    color: #f2f0e9;
    border-color: #111111;
  }

  .button-dark:hover {
    background: #292929;
  }

  .button-light {
    background: #efede7;
    color: #111111;
    border-color: #efede7;
  }

  .button-light:hover {
    background: #ffffff;
  }

  .button-outline {
    background: transparent;
    color: #111111;
    border-color: #b8b5ad;
  }

  .button-outline:hover {
    background: #dcd9d1;
    border-color: #111111;
  }

  .button-outline-dark {
    background: transparent;
    color: #111111;
    border-color: #111111;
  }

  .button-outline-dark:hover {
    background: #111111;
    color: #efede7;
  }

  /* =============================================================
     HERO
  ============================================================= */

  .hero {
    background: #efede7;
    border-bottom: 1px solid #c8c5bd;
  }

  .hero-topline {
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #77736b;
    border-bottom: 1px solid #c8c5bd;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .hero-grid {
    display: grid;
    gap: 28px;
    padding: 38px 0 34px;
  }

  .hero-main {
    max-width: 820px;
  }

  .eyebrow {
    margin: 0 0 15px;
    color: #6d6961;
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(
      52px,
      15vw,
      118px
    );
    font-weight: 950;
    line-height: 0.83;
    letter-spacing: -0.085em;
  }

  .hero h1 span {
    display: block;
    color: #737067;
  }

  .hero-copy {
    max-width: 575px;
    margin: 22px 0 0;
    color: #5d5952;
    font-size: 14px;
    line-height: 1.7;
  }

  .hero-actions {
    display: grid;
    gap: 8px;
    margin-top: 24px;
  }

  .hero-side {
    display: grid;
    gap: 9px;
  }

  .hero-card {
    padding: 15px;
  }

  .hero-card-dark {
    background: #111111;
    color: #efede7;
  }

  .hero-card-light {
    background: #dbd8d0;
    color: #111111;
    border: 1px solid #c2beb5;
  }

  .hero-card-label,
  .hero-card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hero-card-label {
    padding-bottom: 10px;
    margin-bottom: 3px;
    border-bottom: 1px solid #343434;
    color: #96928b;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .status-live {
    color: #a7bc9e;
  }

  .hero-card-row {
    padding: 8px 0;
    border-bottom: 1px solid #292929;
    color: #7d7971;
    font-size: 7px;
    letter-spacing: 0.08em;
  }

