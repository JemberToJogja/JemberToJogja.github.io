    color: #77736b;

    font-size: 9px;

    line-height: 1.4;
  }

  .game-type {
    align-self: start;

    color: #69655e;

    font-size: 6px;

    font-weight: 900;

    letter-spacing: 0.08em;
  }

  .game-arrow {
