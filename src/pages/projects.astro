---
const projects = [
  {
    number: "01",
    name: "LANDCAM",
    repo: "LandCam-Multispectral-Camera",
    status: "ACTIVE",
    mark: "LC",
    category: "CAMERA / MOBILE",
    description:
      "A mobile camera controller for when walking over to the camera is apparently too much effort.",
    story:
      "LANDCAM explores the connection between a mobile application and a real camera system, turning a collection of hardware interactions into one mobile workflow.",
    technologies: ["Java", "Flutter", "Android", "NFC", "Wi-Fi"],
    capabilities: [
      "Camera control",
      "NFC interaction",
      "Wi-Fi communication",
      "Mobile workflow",
    ],
    github:
      "https://github.com/JemberToJogja/LandCam-Multispectral-Camera",
    accent: "dark",
  },
  {
    number: "02",
    name: "TGS CONNECTION",
    repo: "TGS-Connection-Prototype",
    status: "PROTOTYPE",
    mark: "TG",
    category: "GNSS / CONNECTIVITY",
    description:
      "A small experiment trying to get GNSS devices and phones to politely talk to each other.",
    story:
      "TGS Connection explores mobile communication with external positioning hardware, focusing on the practical problems that appear when software has to talk to devices outside the screen.",
    technologies: ["Dart", "Flutter", "GNSS", "Bluetooth"],
    capabilities: [
      "Device connectivity",
      "Bluetooth communication",
      "GNSS workflow",
      "Mobile interface",
    ],
    github:
      "https://github.com/JemberToJogja/TGS-Connection-Prototype",
    accent: "light",
  },
  {
    number: "03",
    name: "WEBGIS",
    repo: "WebGIS",
    status: "PROJECT",
    mark: "WG",
    category: "GEOSPATIAL / WEB",
    description:
      "Maps, geographic data, and a suspicious amount of zooming in and out.",
    story:
      "WebGIS focuses on presenting geographic information through an interactive web experience, bringing maps and spatial data closer to the people actually looking at them.",
    technologies: ["JavaScript", "GIS", "GeoJSON", "Mapping"],
    capabilities: [
      "Geographic visualization",
      "Spatial data",
      "Interactive maps",
      "Web-based exploration",
    ],
    github:
      "https://github.com/JemberToJogja/WebGIS",
    accent: "paper",
  },
];

const stats = [
  {
    value: "03",
    label: "PUBLIC PROJECTS",
  },
  {
    value: "05+",
    label: "TECHNOLOGIES",
  },
  {
    value: "08",
    label: "GAMES TO PLAY",
  },
];

const games = [
  "KUNTILANAK FLY",
  "DEBUGGER",
  "COMMIT TYPE",
  "SYSTEM 2048",
  "RECEH RUN",
  "WARUNG DEFENSE",
  "STACK TRACE",
  "PIXEL PANIC",
