<style>
  /* =============================================================
     BASE
  ============================================================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #101010;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #f2f0ea;
    color: #111111;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  :global(::selection) {
    background: #111111;
    color: #f2f0ea;
  }

  .container {
    width: min(
      calc(100% - 28px),
      1180px
    );
    margin-inline: auto;
  }

  .mono {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  .section-kicker,
  .eyebrow,
  .hero-meta,
  .hero-bottom,
  .project-number,
  .project-category,
  .featured-category,
  .project-repo,
  .field-stats,
  .final-line {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  .section-kicker {
    margin: 0 0 10px;
    color: #69665f;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .cursor-glow {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
    width: 22px;
    height: 22px;
    pointer-events: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    filter: blur(3px);
    transform:
      translate3d(-50px, -50px, 0);
    opacity: 0;
    mix-blend-mode: difference;
  }

  @media (min-width: 900px) {
    .cursor-glow {
      opacity: 1;
    }
  }

  /* =============================================================
     HEADER
  ============================================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: rgba(16, 16, 16, 0.95);
    color: #f2f0ea;
    border-bottom: 1px solid #2c2c2c;
    backdrop-filter: blur(12px);
  }

  .header-inner {
    width: min(
      calc(100% - 20px),
      1180px
    );
    min-height: 62px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    background: #f2f0ea;
    color: #101010;
    font-size: 10px;
    font-weight: 950;
    letter-spacing: -0.03em;
    transition:
      transform 160ms ease,
      background-color 160ms ease;
  }

  .brand:hover .brand-mark {
    transform:
      rotate(-5deg)
      scale(1.04);
    background: #dce5d3;
  }

  .brand-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.11em;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-github {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid #454545;
    color: #f2f0ea;
    font-size: 17px;
  }

  /* =============================================================
     BUTTON
  ============================================================= */

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 16px;
    border: 1px solid transparent;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );
    transition:
      transform 160ms cubic-bezier(.2,.8,.2,1),
      background-color 140ms ease,
      border-color 140ms ease;
  }

  .button-light {
    background: #f2f0ea;
    color: #111111;
  }

  .button-light:hover {
    background: #ffffff;
  }

  .button-dark {
    background: #111111;
    color: #f2f0ea;
  }

  .button-dark:hover {
    background: #292929;
  }

  .button-primary {
    background: #111111;
    color: #f2f0ea;
  }

  .button-primary:hover {
    background: #292929;
  }

  /* =============================================================
     HERO
  ============================================================= */

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 32px 0 44px;
    background: #f2f0ea;
    border-bottom: 1px solid #cfcbc2;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(
        rgba(17,17,17,0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(17,17,17,0.035) 1px,
        transparent 1px
      );
    background-size: 28px 28px;
    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 90%
      );
  }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgba(17,17,17,0.08);
    border-radius: 50%;
    pointer-events: none;
    animation:
      orbit-float
      9s
      ease-in-out
      infinite;
  }

  .hero-orbit-one {
    width: 260px;
    height: 260px;
    right: -140px;
    top: 30px;
  }

  .hero-orbit-two {
    width: 150px;
    height: 150px;
    right: -85px;
    top: 80px;
    animation-delay: -3s;
  }

  .page-hero .container {
    position: relative;
    z-index: 2;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 54px;
  }

  .back-link {
    font-size: 10px;
    font-weight: 900;
  }

  .hero-meta .mono {
    color: #7e7a72;
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .hero-main {
    display: grid;
    gap: 30px;
  }

  .hero-main-copy {
    max-width: 900px;
  }

  .eyebrow {
    margin: 0 0 17px;
    color: #6c6961;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .hero-title {
    margin: 0;
    overflow: hidden;
    font-size: clamp(
      56px,
      16vw,
      128px
    );
    font-weight: 950;
    line-height: 0.82;
    letter-spacing: -0.085em;
  }

  .hero-title span {
    display: block;
    opacity: 0;
    transform:
      translateY(100%)
      rotate(3deg);
    animation:
      title-in
      800ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-title span:last-child {
    color: #77736c;
    animation-delay: 100ms;
  }

  .hero-copy {
    max-width: 560px;
    margin: 21px 0 0;
    color: #5f5b54;
    font-size: 13px;
    line-height: 1.7;
    opacity: 0;
    transform: translateY(15px);
    animation:
      fade-up
      700ms
      280ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-status {
    width: 145px;
    justify-self: end;
    padding: 14px;
    display: grid;
    gap: 5px;
    background: #dedbd3;
    border: 1px solid #c2beb5;
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    transform:
      rotate(-3deg);
    opacity: 0;
    animation:
      status-in
      800ms
      420ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-status span,
  .hero-status small {
    color: #77736b;
    font-size: 6px;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .hero-status strong {
    font-size: 56px;
    line-height: 0.8;
    letter-spacing: -0.09em;
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 30px;
    padding-top: 13px;
    border-top: 1px solid #cfcbc2;
    color: #7b776f;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.09em;
    opacity: 0;
    animation:
      fade-up
      700ms
      520ms
      cubic-bezier(.16,1,.3,1)
      forwards;
  }

  .hero-bottom span + span::before {
    content: "/";
    margin-right: 14px;
    color: #aaa69d;
  }

  /* =============================================================
     STATS
  ============================================================= */

  .stats-section {
    background: #111111;
    color: #f5f3ec;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stat {
    min-height: 118px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 13px 10px;
    border-right: 1px solid #303030;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 650ms
      cubic-bezier(.16,1,.3,1),
      transform 650ms
      cubic-bezier(.16,1,.3,1);
    transition-delay:
      var(--delay, 0ms);
  }

  .is-visible .stat {
    opacity: 1;
    transform: translateY(0);
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat strong {
    font-size: clamp(
      31px,
      8vw,
      54px
    );
    font-weight: 950;
    line-height: 0.85;
    letter-spacing: -0.07em;
  }

  .stat span {
    color: #949089;
    font-size: 6px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  /* =============================================================
     SHARED SECTIONS
  ============================================================= */

  .featured-section,
  .all-projects-section,
  .game-crossover,
  .philosophy-section,
  .github-section,
  .next-section {
    position: relative;
  }

  .featured-section {
    padding: 56px 0;
    background: #f2f0ea;
  }

  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
  }

  .section-label .section-kicker {
    margin: 0;
  }

  .section-label .mono {
    color: #827e76;
    font-size: 8px;
  }

  /* =============================================================
     FEATURED PROJECT
  ============================================================= */

  .featured-project {
    overflow: hidden;
    padding: 19px;
    background: #111111;
    color: #f5f3ec;
    opacity: 0;
    transform: translateY(25px);
    transition:
      opacity 750ms cubic-bezier(.16,1,.3,1),
      transform 750ms cubic-bezier(.16,1,.3,1);
    transition-delay:
      var(--delay, 0ms);
  }

  .is-visible .featured-project {
    opacity: 1;
    transform: translateY(0);
  }

  .featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .featured-top-left {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .project-number,
  .featured-category {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .project-number {
    color: #8a877f;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #c8d7c2;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.09em;
    white-space: nowrap;
  }

  .status-pill > span {
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    background: #72a46e;
    border-radius: 50%;
    box-shadow:
      0 0 0 3px rgba(114,164,110,0.08);
  }

  .featured-visual {
    position: relative;
    min-height: 270px;
    margin-top: 18px;
    overflow: hidden;
    background: #202020;
    border: 1px solid #333333;
  }

  .visual-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.045) 1px,
        transparent 1px
      );
    background-size: 25px 25px;
    animation:
      visual-grid-move
      9s
      linear
      infinite;
  }

  .visual-crosshair {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 1px solid #565656;
  }

  .visual-crosshair::before,
  .visual-crosshair::after {
    content: "";
    position: absolute;
    background: #565656;
  }

  .visual-crosshair::before {
    left: -6px;
    right: -6px;
    top: 50%;
    height: 1px;
    transform:
      translateY(-50%);
  }

  .visual-crosshair::after {
    top: -6px;
    bottom: -6px;
    left: 50%;
    width: 1px;
    transform:
      translateX(-50%);
  }

  .visual-crosshair-one {
    top: 22px;
    left: 22px;
  }

  .visual-crosshair-two {
    right: 22px;
    bottom: 22px;
  }

  .visual-center {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 12px;
  }

  .visual-mark {
    width: 92px;
    height: 92px;
    display: grid;
    place-items: center;
    background: #f5f3ec;
    color: #111111;
    font-size: 25px;
    font-weight: 950;
    letter-spacing: -0.06em;
    box-shadow:
      0 0 0 1px #f5f3ec,
      0 0 0 14px rgba(245,243,236,0.035);
    animation:
      mark-float
      3.2s
      ease-in-out
      infinite;
  }

  .visual-label {
    color: #87837c;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .visual-data {
    position: absolute;
    display: grid;
    gap: 3px;
    font-size: 6px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .visual-data span {
    color: #77736b;
  }

  .visual-data strong {
    color: #dcd8d1;
    font-size: 8px;
  }

  .visual-data-top {
    top: 20px;
    right: 20px;
  }

  .visual-data-bottom {
    left: 20px;
    bottom: 20px;
  }

  .featured-body {
    display: grid;
    gap: 24px;
    margin-top: 28px;
  }

  .featured-title .mono {
    display: block;
    margin-bottom: 8px;
    color: #87837c;
    font-size: 8px;
    letter-spacing: 0.04em;
  }

  .featured-title h2 {
    margin: 0;
    font-size: clamp(
      43px,
      11vw,
      90px
    );
    font-weight: 950;
    line-height: 0.86;
    letter-spacing: -0.075em;
  }

  .large-copy {
    max-width: 640px;
    margin: 0;
    color: #efede6;
    font-size: 15px;
    line-height: 1.6;
  }

  .small-copy {
    max-width: 650px;
    margin: 16px 0 0;
    color: #a09c95;
    font-size: 12px;
    line-height: 1.7;
  }

  .featured-bottom {
    display: grid;
    gap: 20px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid #343434;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .technology-list span {
    padding: 6px 8px;
    border: 1px solid #aaa69d;
    background: #f2f0ea;
    color: #111111;
    font-size: 8px;
    font-weight: 800;
  }

  .featured-project .technology-list span {
    border-color: #494949;
    background: #222222;
    color: #f5f3ec;
  }

  /* =============================================================
     ALL PROJECTS
  ============================================================= */

  .all-projects-section {
    padding: 56px 0;
    background: #ddd9d1;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 26px;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 700ms
      cubic-bezier(.16,1,.3,1),
      transform 700ms
      cubic-bezier(.16,1,.3,1);
  }

  .is-visible .section-heading {
    opacity: 1;
    transform: translateY(0);
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(
      43px,
      11vw,
      80px
    );
    font-weight: 950;
    line-height: 0.86;
    letter-spacing: -0.075em;
  }

  .section-heading > p {
    margin: 0;
    color: #67645d;
    font-size: 12px;
    line-height: 1.6;
  }

  .projects-list {
    display: grid;
    gap: 12px;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding: 19px;
    border: 1px solid #bbb7ae;
    opacity: 0;
    transform:
      translateY(30px);
    transition:
      opacity 700ms
      cubic-bezier(.16,1,.3,1),
      transform 700ms
      cubic-bezier(.16,1,.3,1),
      background-color 160ms ease;
    transition-delay:
      var(--delay, 0ms);
  }

  .is-visible .project-card {
    opacity: 1;
    transform:
      translateY(0);
  }

  .project-dark {
    background: #111111;
    color: #f5f3ec;
    border-color: #111111;
  }

  .project-light {
    background: #f5f3ec;
    color: #111111;
  }

  .project-paper {
    background: #ebe8df;
    color: #111111;
  }

  .project-card:hover {
    transform:
      translateY(-3px);
  }

  .project-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .project-top-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    min-width: 0;
  }

  .project-category {
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .project-visual {
    position: relative;
    min-height: 175px;
    margin: 22px 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #d7d3ca;
    border: 1px solid #c0bcb2;
  }

  .project-dark .project-visual {
    background: #202020;
    border-color: #333333;
  }

  .project-visual-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgba(17,17,17,0.07) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(17,17,17,0.07) 1px,
        transparent 1px
      );
    background-size: 22px 22px;
    animation:
      project-grid-move
      8s
      linear
      infinite;
  }

  .project-dark .project-visual-grid {
    background-image:
      linear-gradient(
        rgba(255,255,255,0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.045) 1px,
        transparent 1px
      );
  }

  .project-mark {
    position: relative;
    z-index: 2;
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    background: #111111;
    color: #f5f3ec;
    font-size: 22px;
    font-weight: 950;
    letter-spacing: -0.05em;
    transition:
      transform 180ms ease;
  }

  .project-card:hover .project-mark {
    transform:
      rotate(3deg)
      scale(1.04);
  }

  .project-dark .project-mark {
    background: #f5f3ec;
    color: #111111;
  }

  .project-visual-label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    color: #6f6b64;
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 6px;
    font-weight: 900;
    letter-spacing: 0.09em;
  }

  .project-dark .project-visual-label {
    color: #77736b;
  }

  .project-content {
    min-width: 0;
  }

  .project-repo {
    margin: 0 0 7px;
    color: #77736c;
    font-size: 8px;
    letter-spacing: 0.04em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-dark .project-repo {
    color: #88857e;
  }

  .project-content h3 {
    margin: 0;
    font-size: clamp(
      30px,
      8vw,
      55px
    );
    font-weight: 950;
    line-height: 0.89;
    letter-spacing: -0.07em;
  }

  .project-description {
    margin: 15px 0 0;
    font-size: 13px;
    line-height: 1.62;
  }

  .project-story {
    margin: 13px 0 0;
    color: #68645d;
    font-size: 12px;
    line-height: 1.68;
  }

  .project-dark .project-story {
    color: #aaa69f;
  }

  .project-content .technology-list {
    margin-top: 18px;
  }

  .project-content .technology-list span {
    font-size: 7px;
  }

  .project-footer {
    display: grid;
    gap: 18px;
    margin-top: 25px;
    padding-top: 18px;
    border-top: 1px solid #c6c2b9;
  }

  .project-dark .project-footer {
    border-color: #353535;
  }

  .capability-list {
    display: grid;
    gap: 6px;
  }

  .capability-list span {
    color: #65615a;
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-dark .capability-list span {
    color: #a8a49d;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .project-link span {
    font-size: 15px;
    transition:
      transform 140ms ease;
  }

  .project-link:hover span {
    transform:
      translate(3px, -3px);
  }

  /* =============================================================
     GAME CROSSOVER
  ============================================================= */

  .game-crossover {
    overflow: hidden;
    padding: 16px 0;
    background: #101010;
    color: #f5f3ec;
  }

  .game-crossover-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.23;
    background-image:
      linear-gradient(
        rgba(255,255,255,0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.035) 1px,
        transparent 1px
      );
    background-size: 25px 25px;
    animation:
      project-grid-move
      10s
      linear
      infinite;
  }

  .game-crossover-card {
    position: relative;
    z-index: 2;
    padding: 25px 20px;
    background: #1d1d1d;
    border: 1px solid #373737;
    opacity: 0;
    transform:
      translateY(28px);
    transition:
      opacity 750ms
      cubic-bezier(.16,1,.3,1),
      transform 750ms
      cubic-bezier(.16,1,.3,1);
  }

  .is-visible .game-crossover-card {
    opacity: 1;
    transform:
      translateY(0);
  }

  .game-crossover-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .game-crossover-top .section-kicker {
    color: #7f7b74;
    margin: 0;
  }

  .game-crossover-top .mono {
    color: #77736b;
    font-size: 7px;
    letter-spacing: 0.09em;
  }

  .game-crossover-main {
    display: grid;
    gap: 30px;
    margin-top: 30px;
  }

  .game-crossover-main h2 {
    margin: 0;
    font-size: clamp(
      44px,
      12vw,
      88px
    );
    font-weight: 950;
    line-height: 0.83;
    letter-spacing: -0.08em;
  }

  .game-crossover-main h2 span {
    display: block;
    color: #77736b;
  }

  .game-crossover-main p {
    max-width: 450px;
    margin: 15px 0 0;
    color: #aaa69f;
    font-size: 12px;
    line-height: 1.6;
  }

  .game-mini-list {
    display: grid;
    border-top: 1px solid #343434;
  }

  .game-mini {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid #2e2e2e;
    color: #e6e3dc;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateX(16px);
  }

  .is-visible .game-mini {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 550ms cubic-bezier(.16,1,.3,1),
      transform 550ms cubic-bezier(.16,1,.3,1);
    transition-delay:
      var(--delay, 0ms);
  }

  .game-mini b {
    color: #6d6962;
    font-size: 7px;
  }

  .game-crossover-button {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    padding: 0 15px;
    background: #f5f3ec;
    color: #111111;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.09em;
    transform:
      translate3d(
        var(--mx, 0),
        var(--my, 0),
        0
      );
    transition:
      transform 160ms cubic-bezier(.2,.8,.2,1),
      background-color 140ms ease;
  }

  .game-crossover-button:hover {
    background: #ffffff;
  }

  .game-crossover-button strong {
    font-size: 17px;
    transition:
      transform 140ms ease;
  }

  .game-crossover-button:hover strong {
    transform:
      translateX(4px);
  }

  /* =============================================================
     PHILOSOPHY
  ============================================================= */

  .philosophy-section {
    padding: 58px 0;
    background: #111111;
    color: #f5f3ec;
