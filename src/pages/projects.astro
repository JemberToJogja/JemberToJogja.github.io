---
const projects = [
  {
    number: "01",
    name: "LANDCAM",
    repo: "LandCam-Multispectral-Camera",
    status: "ACTIVE",
    mark: "LC",
    category: "CAMERA / MOBILE",
    description:
      "A mobile camera controller for when walking over to the camera is apparently too much effort.",
    story:
      "LANDCAM explores the connection between a mobile application and a real camera system, turning a collection of hardware interactions into one mobile workflow.",
    technologies: ["Java", "Flutter", "Android", "NFC", "Wi-Fi"],
    capabilities: [
      "Camera control",
      "NFC interaction",
      "Wi-Fi communication",
      "Mobile workflow",
    ],
    github:
      "https://github.com/JemberToJogja/LandCam-Multispectral-Camera",
    accent: "dark",
  },
  {
    number: "02",
    name: "TGS CONNECTION",
    repo: "TGS-Connection-Prototype",
    status: "PROTOTYPE",
    mark: "TG",
    category: "GNSS / CONNECTIVITY",
    description:
      "A small experiment trying to get GNSS devices and phones to politely talk to each other.",
    story:
      "TGS Connection explores mobile communication with external positioning hardware, focusing on the practical problems that appear when software has to talk to devices outside the screen.",
    technologies: ["Dart", "Flutter", "GNSS", "Bluetooth"],
    capabilities: [
      "Device connectivity",
      "Bluetooth communication",
      "GNSS workflow",
      "Mobile interface",
    ],
    github:
      "https://github.com/JemberToJogja/TGS-Connection-Prototype",
    accent: "light",
  },
  {
    number: "03",
    name: "WEBGIS",
    repo: "WebGIS",
    status: "PROJECT",
    mark: "WG",
    category: "GEOSPATIAL / WEB",
    description:
      "Maps, geographic data, and a suspicious amount of zooming in and out.",
    story:
      "WebGIS focuses on presenting geographic information through an interactive web experience, bringing maps and spatial data closer to the people actually looking at them.",
    technologies: ["JavaScript", "GIS", "GeoJSON", "Mapping"],
    capabilities: [
      "Geographic visualization",
      "Spatial data",
      "Interactive maps",
      "Web-based exploration",
    ],
    github:
      "https://github.com/JemberToJogja/WebGIS",
    accent: "paper",
  },
];

const stats = [
  {
    value: "03",
    label: "PUBLIC PROJECTS",
  },
  {
    value: "05+",
    label: "TECHNOLOGIES",
  },
  {
    value: "01",
    label: "VERY GOOD REASON TO KEEP BUILDING",
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content="Projects built by JemberToJogja — software, geospatial systems, mobile technology, imaging, and experiments."
    />

    <meta
      name="theme-color"
      content="#101010"
    />

    <meta
      property="og:title"
      content="Projects — JemberToJogja"
    />

    <meta
      property="og:description"
      content="Things we made. Some work. Some experiments. All open to inspection."
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://jembertojogja.github.io/projects"
    />

    <link
      rel="canonical"
      href="https://jembertojogja.github.io/projects"
    />

    <title>
      Projects — JemberToJogja
    </title>
  </head>

  <body>
    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="site-header">
      <div class="header-inner">
        <a
          href="/"
          class="brand"
          aria-label="JemberToJogja home"
        >
          <span class="brand-mark">JTJ</span>
          <span class="brand-name">JEMBERTOJOGJA</span>
        </a>

        <nav
          class="desktop-nav"
          aria-label="Primary navigation"
        >
          <a
            href="/projects"
            class="active"
          >
            Projects
          </a>

          <a href="/members">
            People
          </a>

          <a href="/play">
            Play
          </a>

          <a
            href="https://github.com/JemberToJogja"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </nav>

        <a
          class="mobile-github"
          href="https://github.com/JemberToJogja"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open JemberToJogja on GitHub"
        >
          ↗
        </a>
      </div>
    </header>

    <main>
      <!-- =========================================================
           PAGE HERO
      ========================================================== -->

      <section class="page-hero">
        <div class="container">
          <div class="hero-meta">
            <a href="/" class="back-link">
              ← Back home
            </a>

            <span class="mono">
              PROJECTS / 01
            </span>
          </div>

          <div class="hero-main">
            <div>
              <p class="eyebrow">
                THINGS WE MADE
              </p>

              <h1>
                Projects
                <span>we're building.</span>
              </h1>
            </div>

            <div class="hero-description">
              <p>
                Software, hardware experiments, maps, mobile apps,
                and other things that started with:
              </p>

              <strong>
                "How hard could it be?"
              </strong>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================================================
           STATS
      ========================================================== -->

      <section class="stats-section">
        <div class="container stats-grid">
          {
            stats.map((stat) => (
              <div class="stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- =========================================================
           FEATURED PROJECT
      ========================================================== -->

      <section class="featured-section">
        <div class="container">
          <div class="section-label">
            <span class="section-kicker">
              FEATURED PROJECT
            </span>

            <span class="mono">
              01 / 03
            </span>
          </div>

          <article class="featured-project">
            <div class="featured-top">
              <div>
                <span class="project-number">
                  {projects[0].number}
                </span>

                <span class="featured-category">
                  {projects[0].category}
                </span>
              </div>

              <span class="status-pill">
                <span></span>
                {projects[0].status}
              </span>
            </div>

            <div class="featured-mark">
              {projects[0].mark}
            </div>

            <div class="featured-body">
              <div class="featured-title">
                <p class="mono">
                  {projects[0].repo}
                </p>

                <h2>
                  {projects[0].name}
                </h2>
              </div>

              <div class="featured-description">
                <p class="large-copy">
                  {projects[0].description}
                </p>

                <p class="small-copy">
                  {projects[0].story}
                </p>
              </div>
            </div>

            <div class="featured-bottom">
              <div class="technology-list">
                {
                  projects[0].technologies.map((technology) => (
                    <span>{technology}</span>
                  ))
                }
              </div>

              <a
                class="button button-light"
                href={projects[0].github}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open GitHub
                <span>↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- =========================================================
           ALL PROJECTS
      ========================================================== -->

      <section class="all-projects-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-kicker">
                THE REST OF THE STORY
              </p>

              <h2>
                More stuff.
              </h2>
            </div>

            <p>
              No ranking. No competition.
              <br />
              We like all of them.
            </p>
          </div>

          <div class="projects-list">
            {
              projects.slice(1).map((project) => (
                <article
                  class:list={[
                    "project-card",
                    `project-${project.accent}`,
                  ]}
                >
                  <div class="project-top">
                    <div>
                      <span class="project-number">
                        {project.number}
                      </span>

                      <span class="project-category">
                        {project.category}
                      </span>
                    </div>

                    <span class="status-pill small">
                      <span></span>
                      {project.status}
                    </span>
                  </div>

                  <div class="project-mark">
                    {project.mark}
                  </div>

                  <div class="project-content">
                    <p class="project-repo mono">
                      {project.repo}
                    </p>

                    <h3>
                      {project.name}
                    </h3>

                    <p class="project-description">
                      {project.description}
                    </p>

                    <p class="project-story">
                      {project.story}
                    </p>

                    <div class="technology-list">
                      {
                        project.technologies.map((technology) => (
                          <span>{technology}</span>
                        ))
                      }
                    </div>
                  </div>

                  <div class="project-footer">
                    <div class="capability-list">
                      {
                        project.capabilities.map((capability) => (
                          <span>{capability}</span>
                        ))
                      }
                    </div>

                    <a
                      class="project-link"
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      See the code
                      <span>↗</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================================================
           ENGINEERING PHILOSOPHY
      ========================================================== -->

      <section class="philosophy-section">
        <div class="container philosophy-grid">
          <div>
            <p class="section-kicker">
              HOW WE BUILD
            </p>

            <h2>
              Start with an idea.
              Figure out the rest.
            </h2>
          </div>

          <div class="philosophy-list">
            <article>
              <span class="mono">01</span>

              <div>
                <h3>
                  Make it real.
                </h3>

                <p>
                  Ideas are nice. Working software is nicer.
                </p>
              </div>
            </article>

            <article>
              <span class="mono">02</span>

              <div>
                <h3>
                  Break things responsibly.
                </h3>

                <p>
                  Prototypes exist because perfect plans don't.
                </p>
              </div>
            </article>

            <article>
              <span class="mono">03</span>

              <div>
                <h3>
                  Keep learning.
                </h3>

                <p>
                  Documentation exists for a reason.
                  We occasionally read it.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- =========================================================
           GITHUB CTA
      ========================================================== -->

      <section class="github-section">
        <div class="container">
          <div class="github-card">
            <div>
              <p class="section-kicker">
                WANT THE RECEIPTS?
              </p>

              <h2>
                The code is
                <span>right over there.</span>
              </h2>

              <p>
                Everything public lives on GitHub.
                Go inspect it. We dare you.
              </p>
            </div>

            <a
              class="button button-dark"
              href="https://github.com/JemberToJogja"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit the GitHub
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <!-- =========================================================
           NEXT
      ========================================================== -->

      <section class="next-section">
        <div class="container next-grid">
          <div>
            <p class="section-kicker">
              WHAT'S NEXT?
            </p>

            <h2>
              Meet the humans.
            </h2>

            <p>
              Every project needs someone to blame.
            </p>
          </div>

          <a
            class="button button-primary"
            href="/members"
          >
            Meet the people
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- =========================================================
           FOOTER
      ========================================================== -->

      <section class="final-section">
        <div class="container">
          <div class="final-line">
            <span class="mono">
              JEMBERTOJOGJA / {year}
            </span>

            <p>
              Built with Astro. Hosted on GitHub Pages.
              Still trying to figure out why it works.
            </p>

            <span class="mono">
              PROJECTS_DONE_
            </span>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================================================
         MOBILE NAV
    ========================================================== -->

    <nav
      class="mobile-nav"
      aria-label="Mobile navigation"
    >
      <a
        href="/"
        aria-label="Home"
      >
        <span>⌂</span>
        Home
      </a>

      <a
        href="/projects"
        class="active"
        aria-label="Projects"
      >
        <span>＋</span>
        Projects
      </a>

      <a
        href="/members"
        aria-label="People"
      >
        <span>●</span>
        People
      </a>

      <a
        href="/play"
        aria-label="Play"
      >
        <span>▶</span>
        Play
      </a>
    </nav>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f2f0ea;
    color: #111111;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  :global(::selection) {
    background: #111111;
    color: #f2f0ea;
  }

  .container {
    width: min(100% - 32px, 1180px);
    margin-inline: auto;
  }

  .mono {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
  }

  /* =============================================================
     HEADER
  ============================================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #101010;
    color: #f5f3ec;
    border-bottom: 1px solid #2b2b2b;
  }

  .header-inner {
    width: min(100% - 24px, 1180px);
    min-height: 64px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    background: #f5f3ec;
    color: #101010;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .brand-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.11em;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-github {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid #454545;
    color: #f5f3ec;
    font-size: 17px;
  }

  /* =============================================================
     GENERAL
  ============================================================= */

  .eyebrow,
  .section-kicker {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .section-kicker {
    color: #66645e;
    margin: 0 0 10px;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 18px;
    border: 1px solid transparent;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: -0.01em;
    transition:
      transform 140ms ease,
      background-color 140ms ease,
      color 140ms ease;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button-primary {
    background: #111111;
    color: #f5f3ec;
  }

  .button-primary:hover {
    background: #292929;
  }

  .button-light {
    background: #f5f3ec;
    color: #111111;
  }

  .button-light:hover {
    background: #ffffff;
  }

  .button-dark {
    background: #111111;
    color: #f5f3ec;
  }

  .button-dark:hover {
    background: #292929;
  }

  /* =============================================================
     PAGE HERO
  ============================================================= */

  .page-hero {
    padding: 34px 0 52px;
    background: #f2f0ea;
    border-bottom: 1px solid #cbc8c0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 58px;
  }

  .back-link {
    font-size: 11px;
    font-weight: 800;
  }

  .hero-meta .mono {
    color: #77736c;
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .hero-main {
    display: grid;
    gap: 28px;
  }

  .hero-main .eyebrow {
    margin: 0 0 20px;
    color: #69665f;
  }

  .hero-main h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(54px, 15vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.07em;
    font-weight: 900;
  }

  .hero-main h1 span {
    display: block;
    color: #6c6962;
  }

  .hero-description {
    max-width: 570px;
  }

  .hero-description p {
    margin: 0 0 8px;
    color: #595650;
    font-size: 14px;
    line-height: 1.55;
  }

  .hero-description strong {
    font-size: 17px;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  /* =============================================================
     STATS
  ============================================================= */

  .stats-section {
    background: #111111;
    color: #f5f3ec;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stat {
    min-height: 122px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    padding: 15px 12px;
    border-right: 1px solid #303030;
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat strong {
    font-size: clamp(30px, 8vw, 54px);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .stat span {
    color: #95928a;
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 7px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  /* =============================================================
     SECTION HELPERS
  ============================================================= */

  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .section-label .section-kicker {
    margin: 0;
  }

  .section-label .mono {
    color: #86827a;
    font-size: 9px;
  }

  /* =============================================================
     FEATURED
  ============================================================= */

  .featured-section {
    padding: 58px 0;
    background: #f2f0ea;
  }

  .featured-project {
    padding: 20px;
    background: #111111;
    color: #f5f3ec;
  }

  .featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .featured-top > div {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .project-number,
  .featured-category {
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .project-number {
    color: #88857d;
  }

  .featured-category {
    color: #f5f3ec;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #c5d4c0;
    font-family:
      "SFMono-Regular",
      "Cascadia Code",
      "Roboto Mono",
      Consolas,
      monospace;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.09em;
    white-space: nowrap;
  }

  .status-pill > span {
    width: 6px;
    height: 6px;
    background: #6fa16f;
    border-radius: 50%;
  }

  .featured-mark {
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    margin: 30px 0 28px;
    background: #f5f3ec;
    color: #111111;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.06em;
  }

  .featured-body {
    display: grid;
    gap: 24px;
  }

  .featured-title .mono {
    display: block;
    margin-bottom: 8px;
    color: #8f8c84;
    font-size: 9px;
    letter-spacing: 0.05em;
  }

  .featured-title h2 {
    margin: 0;
    font-size: clamp(42px, 11vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .large-copy {
    max-width: 640px;
    margin: 0;
    color: #f0eee7;
    font-size: 16px;
    line-height: 1.55;
  }

  .small-copy {
    max-width: 650px;
    margin: 17px 0 0;
    color: #a8a59d;
    font-size: 13px;
    line-height: 1.65;
  }

  .featured-bottom {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #343434;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .technology-list span {
    padding: 7px 9px;
    border: 1px solid #aaa69c;
    background: #f5f3ec;
    color: #111111;
    font-size: 10px;
    font-weight: 700;
  }

  .featured-project .technology-list span {
    border-color: #494949;
    background: #222222;
    color: #f5f3ec;
  }

  /* =============================================================
     ALL PROJECTS
  ============================================================= */

  .all-projects-section {
    padding: 58px 0;
    background: #dedbd3;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .section-heading h2 {
    margin: 0;
